index 0000000..760e380
--- /dev/null
+++ b/python/sglang/srt/rocm_muse_spark/mono_gfx1250/sync/memmodel.py
@@ -0,0 +1,126 @@
+# SPDX-License-Identifier: Apache-2.0
+"""gfx1250 (MI455X) memory-model primitives the mailbox needs: the buffer
+cache-policy words, the store / load drains, release fences, the 100 MHz clock,
+and the few ``ops`` helpers ``sync`` / ``ranks`` call, under their
+``k2bundle.ops.common.ops`` names so the ported ``ops.py`` can re-export them.
+
+Cache policy (LLVM ``CPol`` for GFX12, the buffer intrinsics' ``aux``): bits
+0-2 TH (temporal hint), bits 3-4 SCOPE. gfx950's SC0 / SC1 / NT bits do not
+exist here; the same numbers mean other things (gfx950 CM_SYS = 17 would be
+SCOPE_DEV | TH_NT, gfx950 CM_NT = 2 would be TH_HT). What hipcc emits for the
+HIP atomics K2's hand-offs correspond to (``probe/memmodel_probe.s``):
+
+- relaxed system-scope 64-bit store / load: ``global_{store,load}_b64 ...
+  scope:SCOPE_SYS``, no fence, no wait: the tagged mailbox pair;
+- relaxed agent-scope: the same with ``scope:SCOPE_DEV``;
+- release fence, agent: ``s_wait_storecnt 0; global_wb scope:SCOPE_DEV;
+  s_wait_storecnt 0`` (the per-XCD L2 is not coherent across the device, so
+  plain stores need a write-back before a flag may announce them);
+- release fence, system: the same with ``scope:SCOPE_SYS``;
+- acquire, agent: ``global_inv scope:SCOPE_DEV``;
+- the clock: ``s_sendmsg_rtn_b64 MSG_RTN_GET_REALTIME`` (100 MHz, as gfx950's
+  ``s_memrealtime``, which gfx12 no longer has).
+"""
+
+from __future__ import annotations
+
+import flydsl.expr as fx
+from aiter.ops.flydsl.kernels import buffer_ops as bo
+from flydsl._mlir.dialects import llvm
+from flydsl.compiler.ast_rewriter import ASTRewriter
+from flydsl.expr import rocdl
+from flydsl.expr.typing import T
+
+# GFX12 CPol
+TH_RT = 0  # regular temporal (default)
+TH_NT = 1  # nontemporal
+TH_HT = 2  # high temporal
+SCOPE_CU = 0 << 3
+SCOPE_SE = 1 << 3
+SCOPE_DEV = 2 << 3
+SCOPE_SYS = 3 << 3
+
+CM_DEV = SCOPE_DEV  # 16: device scope (past the per-XCD L2); gfx950: SC1 = 16
+CM_SYS = SCOPE_SYS  # 24: system scope (peers over XGMI); gfx950: SC0 | SC1 = 17
+CM_NT = TH_NT  # 1: stream a once-read weight past the caches; gfx950: NT = 2
+
+TICKS_PER_SECOND = 100_000_000  # the realtime counter (S0: wall clock 100000 kHz)
+
+_SCOPE_NAME = {SCOPE_DEV: "agent", SCOPE_SYS: "one-as"}
+
+
+def traced(fn):
+    """Apply flydsl's AST rewriting to a helper, so its ``while`` / ``if`` over
+    traced values lower to scf ops. Kernels rewrite only their own body."""
+    return ASTRewriter.transform(fn)
+
+
+def memrealtime():
+    """The 100 MHz device clock: ``llvm.readsteadycounter`` (gfx12's
+    ``s_sendmsg_rtn_b64 REALTIME``; the gfx950 name is kept)."""
+    return fx.Int64(llvm.call_intrinsic(T.i64, "llvm.readsteadycounter", [], [], []))
+
+
+def wait_stores():
+    """Every store this wave issued complete (gfx950: ``s_waitcnt vmcnt(0)``,
+    which also covered loads; gfx12 counts them apart)."""
+    rocdl.s_wait_storecnt(0)
+
+
+def wait_loads():
+    rocdl.s_wait_loadcnt(0)
+
+
+def fence_release(scope):
+    """Release fence at ``scope`` (CM_DEV or CM_SYS): the LLVM memory model's
+    sequence, i.e. drain stores and write the L2 back to that scope."""
+    llvm.FenceOp(llvm.AtomicOrdering.release, syncscope=_SCOPE_NAME[scope])
+
+
+def fence_acquire(scope):
+    """Acquire fence at ``scope``: invalidate the caches below it."""
+    llvm.FenceOp(llvm.AtomicOrdering.acquire, syncscope=_SCOPE_NAME[scope])
+
+
+def rsrc(addr, nbytes=None):
+    return bo.create_buffer_resource_from_addr(addr, num_records_bytes=nbytes)
+
+
+def uniform(v):
+    return fx.Int32(rocdl.readfirstlane(T.i32, fx.Int32(v).ir_value()))
+
+
+def ld_i32(ptr, i):
+    """Word ``i`` of a buffer, a plain Int32 load."""
+    return fx.Int32(bo.buffer_load(rsrc(ptr), i, vec_width=1, dtype=T.i32))
+
+
+def load_ptr64(table, i):
+    """Entry ``i`` of an i64 table in memory, wave-uniform (each half through
+    ``uniform``): a peer's buffer base, a kernel argument block's pointer."""
+    pw = fx.Vector(bo.buffer_load(rsrc(table), i * 2, vec_width=2, dtype=T.i32))
+    return (fx.Int64(uniform(pw[1])) << 32) | fx.Int64(fx.Uint32(uniform(pw[0])))
+
+
+def bf16_pair(a, b):
+    """Two f32 -> one f32-typed word holding (bf16(a), bf16(b))."""
+    return (
+        fx.Vector.from_elements([a, b], fx.Float32)
+        .to(fx.BFloat16)
+        .bitcast(fx.Float32)[0]
+    )
+
+
+def bf_lo(w):
+    """The f32 of a packed bf16 pair word's low half."""
+    return (w << 16).bitcast(fx.Float32)
+
+
+def bf_hi(w):
+    """The f32 of a packed bf16 pair word's high half."""
+    return (w & fx.Int32(-65536)).bitcast(fx.Float32)
+
+
+def bf2_f32(w):
+    """Packed bf16 pair word -> (f32 low, f32 high)."""
+    return bf_lo(w), bf_hi(w)
diff --git a/python/sglang/srt/rocm_muse_spark/mono_gfx1250/sync/peer.py b/python/sglang/srt/rocm_muse_spark/mono_gfx1250/sync/peer.py
new file mode 100644
index 0000000..ed90a50
--- /dev/null
+++ b/python/sglang/srt/rocm_muse_spark/mono_gfx1250/sync/peer.py
@@ -0,0 +1,318 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+# Adapted from ROCm/ATOM (https://github.com/ROCm/ATOM) at a526f0d, MIT License,
+# Copyright (C) 2026, Advanced Micro Devices, Inc.:
+# atom/mono/runtime/peer_memory.py
+# atom/mono/runtime/consensus.py
+"""Peer memory for in-kernel TP collectives: one uncached buffer a rank, every
+rank holding every peer's address, and the TP agreements that must precede
+anything collective.
+
+gfx1250 / TP4 port: the HIP calls are the same (``hipExtMallocWithFlags`` with
+``hipDeviceMallocUncached``, IPC handles, lazy peer access; AITER's
+``UncachedIpcHeap`` ships in the image). S0 measured no difference between
+uncached, fine-grained and coarse memory for the tagged mailbox on MI455X, so
+uncached is kept for parity with MI355X. ``PeerRuntime`` (new) is the K2
+runner's wiring of it: the peer table past PEER_HEAD, the alarm word, health,
+the epoch counter and the per-step fail-stop check."""
+
+import ctypes
+
+import torch
+import torch.distributed as dist
+from .spec import MonoUnsupported
+
+_HIP_DEVICE_MALLOC_UNCACHED = 0x3  # hipDeviceMallocUncached
+_HIP_IPC_LAZY_ENABLE_PEER_ACCESS = 0x1  # hipIpcMemLazyEnablePeerAccess
+_HIP_IPC_HANDLE_BYTES = 64  # sizeof(hipIpcMemHandle_t)
+
+
+class _HipIpcMemHandle(ctypes.Structure):
+    _fields_ = [("reserved", ctypes.c_ubyte * _HIP_IPC_HANDLE_BYTES)]
+
+
+class _HipIpcHeap:
+    """Uncached device memory and its IPC handles through the HIP runtime: the
+    same calls as aiter's ``UncachedIpcHeap`` (``hipExtMallocWithFlags`` with
+    ``hipDeviceMallocUncached``, ``hipIpcGetMemHandle``, ``hipIpcOpenMemHandle``)
+    for aiter builds that do not ship it. Uncached memory is what makes a peer's
+    system-scope stores visible to a spinning load without fences."""
+
+    _lib: ctypes.CDLL | None = None
+
+    @classmethod
+    def lib(cls) -> ctypes.CDLL:
+        if cls._lib is None:
+            lib = ctypes.CDLL("libamdhip64.so")
+            lib.hipExtMallocWithFlags.argtypes = [
+                ctypes.POINTER(ctypes.c_void_p),
+                ctypes.c_size_t,
+                ctypes.c_uint,
+            ]
+            lib.hipIpcGetMemHandle.argtypes = [
+                ctypes.POINTER(_HipIpcMemHandle),
+                ctypes.c_void_p,
+            ]
+            # the handle is passed by value
+            lib.hipIpcOpenMemHandle.argtypes = [
+                ctypes.POINTER(ctypes.c_void_p),
+                _HipIpcMemHandle,
+                ctypes.c_uint,
+            ]
+            lib.hipIpcCloseMemHandle.argtypes = [ctypes.c_void_p]
+            lib.hipFree.argtypes = [ctypes.c_void_p]
+            lib.hipMemset.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_size_t]
+            lib.hipDeviceSynchronize.argtypes = []
+            cls._lib = lib
+        return cls._lib
+
+    @classmethod
+    def _check(cls, err: int, what: str) -> None:
+        if err != 0:
+            raise RuntimeError(f"{what} failed: hipError {err}")
+
+    @classmethod
+    def alloc_uncached(cls, nbytes: int) -> int:
+        ptr = ctypes.c_void_p()
+        cls._check(
+            cls.lib().hipExtMallocWithFlags(
+                ctypes.byref(ptr), nbytes, _HIP_DEVICE_MALLOC_UNCACHED
+            ),
+            "hipExtMallocWithFlags(uncached)",
+        )
+        cls._check(cls.lib().hipMemset(ptr, 0, nbytes), "hipMemset")
+        cls._check(cls.lib().hipDeviceSynchronize(), "hipDeviceSynchronize")
+        return int(ptr.value)
+
+    @classmethod
+    def get_mem_handle_bytes(cls, ptr: int) -> bytes:
+        handle = _HipIpcMemHandle()
+        cls._check(
+            cls.lib().hipIpcGetMemHandle(ctypes.byref(handle), ctypes.c_void_p(ptr)),
+            "hipIpcGetMemHandle",
+        )
+        return bytes(bytearray(handle.reserved))
+
+    @classmethod
+    def open_mem_handle(cls, handle: bytes) -> int:
+        ptr = ctypes.c_void_p()
+        h = _HipIpcMemHandle.from_buffer_copy(handle)
+        cls._check(
+            cls.lib().hipIpcOpenMemHandle(
+                ctypes.byref(ptr), h, _HIP_IPC_LAZY_ENABLE_PEER_ACCESS
+            ),
+            "hipIpcOpenMemHandle",
+        )
+        return int(ptr.value)
+
+    @classmethod
+    def close_mem_handle(cls, ptr: int) -> None:
+        cls.lib().hipIpcCloseMemHandle(ctypes.c_void_p(ptr))
+
+    @classmethod
+    def free_device_mem(cls, ptr: int) -> None:
+        cls.lib().hipFree(ctypes.c_void_p(ptr))
+
+    @staticmethod
+    def gather_object_list_via_broadcast(group, obj) -> list:
+        out = [None] * dist.get_world_size(group=group)
+        dist.all_gather_object(out, obj, group=group)
+        return out
+
+
+def _heap():
+    try:
+        from aiter.ops.flydsl.quick_allreduce_int4_ipc import UncachedIpcHeap
+
+        return UncachedIpcHeap
+    except ImportError:
+        return _HipIpcHeap
+
+
+class _DeviceBytes:
+    """``__cuda_array_interface__`` of ``nbytes`` bytes at a raw device address, for a
+    non-owning torch view."""
+
+    def __init__(self, ptr: int, nbytes: int):
+        self.__cuda_array_interface__ = {
+            "shape": (nbytes,),
+            "typestr": "|u1",
+            "data": (ptr, False),
+            "version": 3,
+        }
+
+
+class PeerBuffer:
+    """One uncached buffer per rank, every rank holding every peer's address
+    (``addresses``, int64, indexed by TP rank). What lives where, and why no rank
+    overwrites a peer's unread data, is the model's layout's to say.
+
+    ``bytes`` is the whole buffer: the kernels tag every pair with the step's
+    epoch, so it is never zeroed between steps.
+
+    The constructor is collective over ``group`` (the handle exchange, then an
+    agreement that every rank mapped every peer): every rank must reach it, so a
+    runner reaches it only after ``tp_agree``. A failed mapping on any rank raises
+    ``MonoUnsupported`` on all of them.
+    """
+
+    def __init__(
+        self,
+        nbytes: int,
+        group,
+        rank: int,
+        npes: int,
+        device: torch.device,
+    ):
+        heap = _heap()
+        self._heap = heap
+        self.local = 0
+        self.bytes = None
+        self.rank = rank
+        self._opened: list[int] = []
+        handle, failure = None, None
+        try:
+            self.local = heap.alloc_uncached(nbytes)
+            # a view, not an owner: close() frees the memory under it
+            self.bytes = torch.as_tensor(
+                _DeviceBytes(self.local, nbytes), device=device
+            )
+            handle = heap.get_mem_handle_bytes(self.local)
+        except Exception as err:  # noqa: BLE001 - every local refusal is agreed
+            failure = err
+        if not tp_agree(failure is None, group):
+            self.close()
+            raise MonoUnsupported(
+                "uncached peer allocation/handle failed on "
+                f"{'this' if failure else 'another'} TP rank"
+            ) from failure
+
+        addresses = [self.local]
+        if npes > 1:
+            handles = heap.gather_object_list_via_broadcast(group, handle)
+            addresses, failure = [], None
+            try:
+                for peer, handle in enumerate(handles):
+                    if peer == rank:
+                        addresses.append(self.local)
+                    else:
+                        base = heap.open_mem_handle(handle)
+                        self._opened.append(base)
+                        addresses.append(base)
+            except Exception as err:  # noqa: BLE001 - agreement prevents a hang
+                failure = err
+            if not tp_agree(failure is None, group):
+                self.close()
+                raise MonoUnsupported(
+                    "peer memory handshake failed on "
+                    f"{'this' if failure else 'another'}"
+                    " TP rank"
+                ) from failure
+        failure = None
+        try:
+            self.addresses = torch.tensor(
+                addresses, dtype=torch.int64, device=device
+            )
+        except Exception as err:  # noqa: BLE001 - every local refusal is agreed
+            failure = err
+        if not tp_agree(failure is None, group):
+            self.close()
+            raise MonoUnsupported(
+                "peer address table construction failed on "
+                f"{'this' if failure else 'another'} TP rank"
+            ) from failure
+
+    def close(self) -> None:
+        """Close the peer mappings and free the local buffer; idempotent. Only once no
+        kernel of any rank can still touch it (the runner is being dropped)."""
+        opened, self._opened = self._opened, []
+        for base in opened:
+            self._heap.close_mem_handle(base)
+        if self.local:
+            self.bytes = None
+            self._heap.free_device_mem(self.local)
+            self.local = 0
+
+
+# Decisions every TP rank must take alike.
+#
+# A mono kernel waits in-kernel on every peer rank, so a rank that turned mono off
+# alone -- or failed to build what the others launch -- leaves the others spinning
+# on the GPU for ever. Each such decision is a local verdict agreed on over the TP
+# group's CPU group before anything collective (peer handshake, launch) follows.
+#
+
+
+def tp_agree(ok: bool, group) -> bool:
+    """True when every rank of ``group`` passed ``ok`` true. Every rank must call
+    it at the same point; ``group`` is a CPU (gloo) process group, or None for a
+    single rank."""
+    if group is None:
+        return ok
+    flag = torch.tensor([int(ok)], dtype=torch.int32)
+    dist.all_reduce(flag, op=dist.ReduceOp.MIN, group=group)
+    return bool(flag.item())
+
+
+def bind_agreed(bind, group) -> None:
+    """``bind()`` on this rank (raising ``MonoUnsupported`` to refuse), then every
+    rank's verdict agreed: a rank that raised re-raises, the others raise too."""
+    try:
+        bind()
+    except Exception:
+        tp_agree(False, group)
+        raise
+    if not tp_agree(True, group):
+        raise MonoUnsupported("another TP rank refused mono")
+
+
+class PeerRuntime:
+    """A K2 runner's TP state: the peer buffer (``PEER_HEAD`` header bytes, then
+    ``nbytes`` of mailbox regions), and the kernel arguments derived from it.
+
+    - ``peers``: int64 [tp], every rank's buffer base past PEER_HEAD (the
+      kernels' ``peers`` table);
+    - ``alarm``: this rank's flag word in the output rank's header (an address,
+      the kernels' ``alarm``); ``alarm - 4 * rank`` is that header's base, where
+      the K2 completion pairs live (``abi.K2_DONE_OFFSET``);
+    - ``health``: int32, this rank's sticky FAILED word and wait records;
+    - ``epoch``: int32 [1], the step counter the mailbox tags carry, advanced
+      in the graph by ``epoch.advance_epoch_``.
+
+    Collective over ``group`` like ``PeerBuffer``.
+    """
+
+    def __init__(
+        self,
+        nbytes: int,
+        group,
+        rank: int,
+        tp: int,
+        device: torch.device,
+        *,
+        blocks: int,
+        output_rank: int = 0,
+    ):
+        from .abi import PEER_HEAD, health_words
+
+        self.rank, self.tp, self.output_rank = rank, tp, output_rank
+        self.buffer = PeerBuffer(PEER_HEAD + nbytes, group, rank, tp, device)
+        self.peers = self.buffer.addresses + PEER_HEAD
+        base = int(self.buffer.addresses[output_rank].item())
+        self.alarm = base + 4 * rank
+        self.health = torch.zeros(health_words(blocks), dtype=torch.int32, device=device)
+        self.epoch = torch.zeros(1, dtype=torch.int32, device=device)
+
+    def error_words(self) -> torch.Tensor:
+        """The output rank's flag words (a view; meaningful on the output rank)."""
+        return self.buffer.bytes[: 4 * self.tp].view(torch.int32)
+
+    def check(self) -> None:
+        """Fail-stop after a step (output rank): raise if any rank gave up."""
+        from .failstop import check
+
+        if self.rank == self.output_rank:
+            check(self.error_words().cpu())
+
+    def close(self) -> None:
+        self.buffer.close()
