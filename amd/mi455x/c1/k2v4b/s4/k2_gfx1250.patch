index 0000000..08e4410
--- /dev/null
+++ b/python/sglang/srt/rocm_muse_spark/mono_gfx1250/gemv/moe_dense.py
@@ -0,0 +1,395 @@
+"""The dense parts of K2's MoE on gfx1250 at TP4 / EP1 (port of the router, pooler, route, unpooler and gather of
+``k2bundle/ops/stages/moe.py``; the names and signatures are the ones ``ops/k2.py`` calls as ``moe.*``).
+
+The router (fp32 [256, 8192]), pooler (bf16 [4096, 8192]) and unpooler (bf16 [8192, 4096]) are replicated on
+every GPU; each rank computes its quarter and the results are exchanged over the peer buffer, as on MI355X:
+
+    router  (4 x 16 experts of this rank's 64, K quarters, q8: 2 tokens a task): fp32 VALU GEMV, a wave an
+            expert, a lane 4 fp32 every 128 (16 b128 loads, coalesced); per-lane fma chain, wave32 butterfly ->
+            the K quarter's partial to every rank's RLOG_PARTS (q8) or summed in part order through RPART -> RLOG
+    pooler  (64 x 16 rows of this rank's 1024, K quarters): bf16 WMMA GEMV, one 128-K chunk a wave; parts
+            summed in part order through PPART -> bf16 -> every rank's POOL
+    route   (token t, wave 0): the 4 parts of each logit summed in part order, x router_output_multiplier,
+            sigmoid 1 / (1 + exp2(-x log2 e)), + bias, top-8 by a radix select over 32-bit ballots (equal
+            keys: the lower experts), slot order by biased score, weights s_k * (scale / (sum + 1e-15)) -> ROUTE
+    unpool  (128 x 16 rows of this rank's 2048 branch columns, K 4096): bf16 WMMA GEMV of FIN, two chunks a
+            wave -> bf16 -> every rank's BR (AG#4)
+    gather  (64 x 128 columns): BR -> ``branch_out``
+
+``w_pool`` / ``w_unpool`` are read in ``gemv.SHUFFLED`` byte order (preshuffled once at load time,
+``gemv.shuffle_rows`` of the full replicated tensor); the router stays row-major (its loads are coalesced).
+"""
+
+import math
+
+import flydsl.expr as fx
+from aiter.ops.flydsl.kernels import buffer_ops as bo
+from flydsl.expr import const_expr, gpu, range_constexpr
+from flydsl.expr.typing import T
+
+from . import common as C
+from . import gemv
+from .common import (
+    CM_NT,
+    ballot,
+    bf16_round,
+    bf_hi,
+    bf_lo,
+    hw_exp2,
+    lanes_below,
+    popcount,
+    row_sum,
+    rsrc,
+    traced,
+    wave_sum,
+)
+
+TP = C.TP
+H = C.H  # hidden
+MH = 4096  # MoE hidden (pooled)
+E = 256
+TOPK = 8
+EPR = E // TP  # 64 router rows a rank
+ROWS = 16
+LOG2E = 1.0 / math.log(2.0)
+ROUTE_EPS = 1e-15  # router_score_division_eps
+ROUTE_SCALE = 1.0  # routed_scaling_factor
+
+R_GROUPS = EPR // C.WAVES  # 4: 16 experts a task, one a wave
+R_PARTS = 4  # K quarters
+R_K = H // R_PARTS  # 2048
+R_LD = R_K // (4 * C.WAVE)  # 16 b128 loads a lane
+R_TASKS = R_GROUPS * R_PARTS  # 16
+ROUTER_PAIR = 2
+R_TOKEN_GROUPS_Q8 = 8 // ROUTER_PAIR  # 4
+R_TASKS_Q8 = R_TASKS * R_TOKEN_GROUPS_Q8  # 64
+POOL_N = MH // TP  # 1024 pooled columns a rank
+P_GROUPS = POOL_N // ROWS  # 64
+P_PARTS = 4
+P_K = H // P_PARTS  # 2048
+P_TASKS = P_GROUPS * P_PARTS  # 256
+EARLY_K = R_K  # the x part an early task stages (router and pooler alike)
+assert P_K == R_K
+FIN_COLS = 128
+FIN_TASKS = MH // FIN_COLS  # 32 FRDY flags
+UP_N = H // TP  # 2048 branch columns a rank
+UP_TASKS = UP_N // ROWS  # 128
+GATHER_COLS = 128
+GATHER_TASKS = H // GATHER_COLS  # 64
+NSL = 64  # 128-column x slices (non-quarter seam XRDY)
+
+
+def peer_pairs(s):
+    """This module's peer regions, pairs: name -> count."""
+    return {
+        "rlog": TP * s * EPR,  # [src][t][64] fp32
+        "rlog_parts": TP * R_PARTS * s * EPR,  # [src][q][t][64] fp32 (q8)
+        "pool": s * MH // 2,  # [t][4096] bf16 pairs
+        "br": s * H // 2,  # [t][8192] bf16 pairs
+    }
+
+
+def scratch_pairs(s):
+    return {
+        "rpart": R_TASKS * s * C.WAVES,
+        "ppart": P_TASKS * s * ROWS,
+        "route": s * 2 * TOPK,
+        "frdy": FIN_TASKS,
+    }
+
+
+def f32_of(w):
+    return w.bitcast(fx.Float32)
+
+
+def bo_ld_f32(ptr, i):
+    return fx.Float32(bo.buffer_load(rsrc(ptr), i, vec_width=1, dtype=T.f32))
+
+
+# ---------------------------------------------------------------- early
+@traced
+def early_x(c, q):
+    """The x rows' K part q -> LDS after that part's slices are XRDY."""
+    tid = c["tid"]
+    if const_expr(c["quarter_seam"]):
+        if tid < c["S"]:
+            c["poll"]([(c["xrdy"], tid * R_PARTS + q, 1)])
+    else:
+        if tid < NSL // R_PARTS:
+            c["poll"]([(c["xrdy"], q * (NSL // R_PARTS) + tid, 1)])
+    gpu.barrier()
+    gemv.rows_to_lds(tid, c["xbuf"], R_K, c["S"], c["xl"], R_K + gemv.LDS_PAD, C.CM_XROWS, ldk=H, k0=q * R_K)
+
+
+def router_loads(c, i, q):
+    """Router task (i, q): expert rank 64 + 16 i + wave, K quarter q: a lane 4 fp32 every 128 (16 b128)."""
+    lane, wave = c["lane"], c["wave"]
+    e = c["rank"] * EPR + i * C.WAVES + wave
+    r_w = rsrc(c["args"]["w_router"], E * H * 4)
+    base = e * H + q * R_K + lane * 4
+    return [
+        fx.Vector(bo.buffer_load(r_w, base + 4 * C.WAVE * j, vec_width=4, dtype=T.f32, cache_modifier=CM_NT))
+        for j in range(R_LD)
+    ]
+
+
+@traced
+def _router_dots(c, ops, t_rows):
+    """Per LDS token row: the lane's fp32 fma chain over its 64 K, then the wave's sum -> av[t * WAVES + wave]."""
+    lane, wave = c["lane"], c["wave"]
+    xrow = EARLY_K + gemv.LDS_PAD
+    for t in range_constexpr(t_rows):
+        acc = fx.Float32(0.0)
+        for j in range_constexpr(R_LD):
+            xv = fx.Vector(
+                fx.ptr_load(
+                    c["xl"] + (t * xrow + 4 * C.WAVE * j + lane * 4) // 2,
+                    result_type=fx.Vector.make_type(2, fx.Int32),
+                )
+            )
+            w = ops[j]
+            acc = acc + bf_lo(xv[0]) * w[0]
+            acc = acc + bf_hi(xv[0]) * w[1]
+            acc = acc + bf_lo(xv[1]) * w[2]
+            acc = acc + bf_hi(xv[1]) * w[3]
+        v = wave_sum(acc)
+        if lane == 0:
+            fx.ptr_store(v, c["av"] + (t * C.WAVES + wave))
+    gpu.barrier()
+
+
+@traced
+def router_compute(c, i, q, ops):
+    """Router task (i, q), every token: parts q > 0 -> RPART, part 0 adds them in part order -> every rank's
+    RLOG."""
+    s, tid = c["S"], c["tid"]
+    early_x(c, q)
+    _router_dots(c, ops, s)
+    if tid < s * C.WAVES:
+        v = fx.ptr_load(c["av"] + tid)
+        at = (i * R_PARTS + q) * s * C.WAVES + tid
+        if q > 0:
+            c["put"](c["rpart"], at, v)
+        if q == 0:
+            got = c["poll"]([(c["rpart"], at + qq * s * C.WAVES, 1) for qq in range(1, R_PARTS)])
+            for qq in range_constexpr(R_PARTS - 1):
+                v = v + f32_of(got[qq][0])
+            t = tid // C.WAVES
+            w = tid % C.WAVES
+            for p in range_constexpr(TP):
+                c["put"](c["peer"]["rlog"][p], (c["rank"] * s + t) * EPR + i * C.WAVES + w, v)
+    gpu.barrier()
+
+
+@traced
+def router_compute_pair(c, i, q, tg, ops):
+    """Router task (i, q) for tokens 2 tg, 2 tg + 1 (C1 / q8): each K quarter's partial -> every rank's
+    RLOG_PARTS; the route sums the four parts in part order."""
+    s, tid = c["S"], c["tid"]
+    t0 = tg * ROUTER_PAIR
+    if tid < ROUTER_PAIR:
+        c["poll"]([(c["xrdy"], (t0 + tid) * R_PARTS + q, 1)])
+    gpu.barrier()
+    gemv.rows_to_lds(
+        tid, c["xbuf"] + fx.Int64(t0 * (H * 2)), R_K, ROUTER_PAIR, c["xl"], R_K + gemv.LDS_PAD, C.CM_XROWS,
+        ldk=H, k0=q * R_K,
+    )
+    _router_dots(c, ops, ROUTER_PAIR)
+    if tid < ROUTER_PAIR * C.WAVES:
+        v = fx.ptr_load(c["av"] + tid)
+        t = t0 + tid // C.WAVES
+        w = tid % C.WAVES
+        for p in range_constexpr(TP):
+            c["put"](c["peer"]["rlog_parts"][p], ((c["rank"] * R_PARTS + q) * s + t) * EPR + i * C.WAVES + w, v)
+    gpu.barrier()
+
+
+def pool_loads(c, i, q):
+    """Pooler task (i, q): rows rank 1024 + 16 i .., K quarter q (one 128-K chunk a wave)."""
+    return gemv.loads(
+        c["lane"], c["wave"], c["args"]["w_pool"], c["rank"] * POOL_N + i * ROWS, P_K, ldk=H, k0=q * P_K,
+        nbytes=MH * H * 2,
+    )
+
+
+@traced
+def pool_compute(c, i, q, ops):
+    """Pooler task (i, q): bf16 WMMA GEMV of the x part; parts q > 0 -> PPART, part 0 adds them in part order
+    -> bf16 -> every rank's POOL."""
+    s, tid, lane, wave, red = c["S"], c["tid"], c["lane"], c["wave"], c["red"]
+    early_x(c, q)
+    acc = gemv.wmmas(lane, wave, c["xl"], P_K + gemv.LDS_PAD, P_K, s, ops)
+    gemv.store_acc(red, wave, lane, acc)
+    gpu.barrier()
+    if tid < ROWS * s:
+        r = tid % ROWS
+        t = tid // ROWS
+        v = row_sum(red, r, t)
+        at = (i * P_PARTS + q) * s * ROWS + tid
+        if q > 0:
+            c["put"](c["ppart"], at, v)
+        if q == 0:
+            got = c["poll"]([(c["ppart"], at + qq * s * ROWS, 1) for qq in range(1, P_PARTS)])
+            for qq in range_constexpr(P_PARTS - 1):
+                v = v + f32_of(got[qq][0])
+            fx.ptr_store(v, c["av"] + tid)
+    gpu.barrier()
+    if (q == 0) & (tid < (ROWS // 4) * s):
+        rq = tid % (ROWS // 4)
+        t = tid // (ROWS // 4)
+        vs = [bf16_round(fx.ptr_load(c["av"] + (t * ROWS + 4 * rq + d))) for d in range(4)]
+        col = c["rank"] * POOL_N + i * ROWS + 4 * rq
+        for p in range_constexpr(TP):
+            c["put_bf"](c["peer"]["pool"][p], t * MH + col, vs)
+    gpu.barrier()
+
+
+# ---------------------------------------------------------------- route
+def _okey(v):
+    """An order-preserving uint32 key of an f32 (larger float, larger key)."""
+    b = v.bitcast(fx.Int32)
+    neg = b < fx.Int32(0)
+    return fx.Uint32(neg.select(~b, b ^ fx.Int32(-2147483648)))
+
+
+@traced
+def stage_route(c, t):
+    """Token t (wave 0): 256 logits, 8 a lane (expert lane + 32 i) -> x multiplier -> sigmoid (IEEE
+    1 / (1 + exp2(-x log2 e))) + bias -> the top-8 by a radix select (equal keys: the lower experts) -> ranked
+    by biased score, descending -> the unbiased sigmoids times scale / (their slot-order sum + eps) -> ROUTE."""
+    lane, wave, red = c["lane"], c["wave"], c["red"]
+    a = c["args"]
+    use_parts = c.get("rlog_parts", False)
+    mult = c["router_output_multiplier"]
+    if wave == 0:
+        s = c["S"]
+        per = E // C.WAVE  # 8
+        bias = [bo_ld_f32(a["expert_bias"], lane + C.WAVE * i) for i in range(per)]
+        specs = []
+        if const_expr(use_parts):
+            for i in range_constexpr(per):
+                e = lane + C.WAVE * i
+                for qq in range_constexpr(R_PARTS):
+                    specs.append(
+                        (c["peer"]["rlog_parts_own"], (((e // EPR) * R_PARTS + qq) * s + t) * EPR + e % EPR, 1)
+                    )
+            parts = c["poll"](specs, batch=len(specs))  # one round trip (64 VGPRs of pairs)
+            got = []
+            for i in range_constexpr(per):
+                v = f32_of(parts[i * R_PARTS][0])
+                for qq in range_constexpr(1, R_PARTS):
+                    v = v + f32_of(parts[i * R_PARTS + qq][0])
+                got.append([v.bitcast(fx.Int32)])
+        else:
+            for i in range_constexpr(per):
+                e = lane + C.WAVE * i
+                specs.append((c["peer"]["rlog_own"], ((e // EPR) * s + t) * EPR + e % EPR, 1))
+            got = c["poll"](specs)
+        keys, sigs = [], []
+        for i in range_constexpr(per):
+            lg = f32_of(got[i][0])
+            if const_expr(mult != 1.0):
+                lg = lg * fx.Float32(mult)
+            sg = fx.Float32(1.0) / (fx.Float32(1.0) + hw_exp2(lg * fx.Float32(-LOG2E)))
+            sc = sg + bias[i]
+            keys.append(_okey((sc == sc).select(sc, fx.Float32(-3.0e38))))  # noqa: PLR0124
+            sigs.append((sg == sg).select(sg, fx.Float32(0.0)))  # noqa: PLR0124
+
+        def count_ge(th):
+            n = fx.Int32(0)
+            for i in range_constexpr(per):
+                n = n + popcount(ballot(keys[i] >= th))
+            return n
+
+        th = fx.Uint32(0)
+        for bit in range_constexpr(31, -1, -1):
+            cand = th | fx.Uint32(1 << bit)
+            th = (count_ge(cand) >= TOPK).select(cand, th)
+        n_gt = fx.Int32(0)
+        for i in range_constexpr(per):
+            n_gt = n_gt + popcount(ballot(keys[i] > th))
+        need = fx.Int32(TOPK) - n_gt
+        eq_before = fx.Int32(0)
+        sel_before = fx.Int32(0)
+        for i in range_constexpr(per):
+            eqb = ballot(keys[i] == th)
+            eq_rank = eq_before + lanes_below(eqb, lane)
+            sel = (keys[i] > th) | ((keys[i] == th) & (eq_rank < need))
+            selb = ballot(sel)
+            pos = sel_before + lanes_below(selb, lane)
+            if sel:
+                fx.ptr_store(keys[i].bitcast(fx.Float32), red + pos * 3)
+                fx.ptr_store(fx.Int32(lane + C.WAVE * i).bitcast(fx.Float32), red + (pos * 3 + 1))
+                fx.ptr_store(sigs[i], red + (pos * 3 + 2))
+            eq_before = eq_before + popcount(eqb)
+            sel_before = sel_before + popcount(selb)
+        q = fx.min(lane, TOPK - 1)
+        mk = fx.Uint32(fx.ptr_load(red + q * 3).bitcast(fx.Int32))
+        me = fx.ptr_load(red + (q * 3 + 1)).bitcast(fx.Int32)
+        ms = fx.ptr_load(red + (q * 3 + 2))
+        rank = fx.Int32(0)
+        for j in range_constexpr(TOPK):
+            ok = fx.Uint32(fx.ptr_load(red + j * 3).bitcast(fx.Int32))
+            oe = fx.ptr_load(red + (j * 3 + 1)).bitcast(fx.Int32)
+            before = (ok > mk) | ((ok == mk) & (oe < me))
+            rank = rank + before.select(fx.Int32(1), fx.Int32(0))
+        if lane < TOPK:
+            fx.ptr_store(ms, red + (64 + rank))
+        total = fx.Float32(0.0)
+        for j in range_constexpr(TOPK):
+            total = total + fx.ptr_load(red + (64 + j))
+        inv = fx.Float32(ROUTE_SCALE) / (total + fx.Float32(ROUTE_EPS))
+        if lane < TOPK:
+            c["put"](c["route"], t * 2 * TOPK + rank, fx.min(fx.max(me, 0), fx.Int32(E - 1)))
+            c["put"](c["route"], t * 2 * TOPK + TOPK + rank, ms * inv)
+    gpu.barrier()
+
+
+# ---------------------------------------------------------------- unpooler / gather
+def up_loads(c, j):
+    """Unpooler task j: rows (branch columns) rank 2048 + 16 j .., K 4096 (two chunks a wave)."""
+    return gemv.loads(c["lane"], c["wave"], c["args"]["w_unpool"], c["rank"] * UP_N + j * ROWS, MH, nbytes=H * MH * 2)
+
+
+def up_loads_masked(c, j, live):
+    """``up_loads`` with a CTA predicate, for issue ahead of FRDY: the same addresses (clamped task) and cache
+    policy; a masked lane's offset falls outside the sized descriptor."""
+    jj = fx.max(fx.min(j, UP_TASKS - 1), 0)
+    return gemv.loads(
+        c["lane"], c["wave"], c["args"]["w_unpool"], c["rank"] * UP_N + jj * ROWS, MH, mask=live, nbytes=H * MH * 2
+    )
+
+
+@traced
+def stage_up(c, j, ops):
+    """Branch columns rank 2048 + 16 j ..: FIN (after every FRDY) GEMV -> bf16 -> every rank's BR."""
+    s, tid, lane, wave, red = c["S"], c["tid"], c["lane"], c["wave"], c["red"]
+    if tid < c.get("frdy_flags", FIN_TASKS):
+        c["poll"]([(c["frdy"], tid, 1)])
+    gpu.barrier()
+    lrow = MH + gemv.LDS_PAD
+    gemv.dev_rows_to_lds(tid, c["fin"], MH, s, c["xl"], lrow)
+    acc = gemv.wmmas(lane, wave, c["xl"], lrow, MH, s, ops)
+    gemv.store_acc(red, wave, lane, acc)
+    gpu.barrier()
+    if tid < (ROWS // 4) * s:
+        rq = tid % (ROWS // 4)
+        tt = tid // (ROWS // 4)
+        vs = [bf16_round(row_sum(red, 4 * rq + d, tt)) for d in range(4)]
+        col = c["rank"] * UP_N + j * ROWS + 4 * rq
+        for p in range_constexpr(TP):
+            c["put_bf"](c["peer"]["br"][p], tt * H + col, vs)
+    gpu.barrier()
+
+
+@traced
+def stage_gather(c, j):
+    """Branch columns 128 j ..: BR (every rank's columns) -> ``branch_out``; wave = token, 4 columns a lane."""
+    s, lane, wave = c["S"], c["lane"], c["wave"]
+    live = wave < s
+    t = fx.min(wave, s - 1)
+    col = j * GATHER_COLS + 4 * lane
+    w = c["poll"]([(c["peer"]["br_own"], (t * H + col) // 2, 2)])[0]
+    if live:
+        bo.buffer_store(fx.Vector.from_elements(w, fx.Int32), rsrc(c["args"]["branch_out"]), (t * H + col) // 2)
+    gpu.barrier()
diff --git a/python/sglang/srt/rocm_muse_spark/mono_gfx1250/gemv/oproj.py b/python/sglang/srt/rocm_muse_spark/mono_gfx1250/gemv/oproj.py
new file mode 100644
index 0000000..eff4e84
--- /dev/null
+++ b/python/sglang/srt/rocm_muse_spark/mono_gfx1250/gemv/oproj.py
@@ -0,0 +1,107 @@
+"""K2's o_proj on gfx1250 at TP4 (port of ``k2bundle/ops/stages/oproj.py``): the core rows (T x 2048 bf16, this
+rank's K slice: 32 q heads x 64) against the rank's RowParallel shard of o_proj (bf16 [8192, 2048]) -> bf16
+partials -> AR#1.
+
+512 tiles of 16 rows, two a CTA (b, b + 256).  The CTA's 16 waves split them: waves 8 j .. 8 j + 7 own tile j,
+each two 128-K chunks of its K = 2048 (256 B of weights a lane, every load issued before the core rows land),
+so a row's fp32 sum is its tile's 8 wave sums in wave order.  MI355X's C1 build (``stage_oproj_deep``) kept one
+wave a tile with a single K chain to match the production gfx950 kernel bit for bit; on gfx1250 there is no
+such reference to match, and the split-K form has a quarter of the per-wave latency chain.
+
+``stage_oproj_deep`` (C1, q8) reduce-scatters: a tile's partials go to its column owner only (``ar_owner``,
+owner = row // 2048).  ``stage_oproj`` (the default build) pushes them to every rank (``ar_peer``).
+"""
+
+import flydsl.expr as fx
+from aiter.ops.flydsl.kernels import buffer_ops as bo
+from flydsl.expr import const_expr, gpu, range_constexpr
+from flydsl.expr.typing import T
+
+from . import common as C
+from . import gemv
+from .common import bf16_round, rsrc, traced
+
+TP = C.TP
+H = C.H  # o_proj's rows (hidden)
+CORE = H // TP  # 2048: o_proj's K a rank
+ROWS = 16
+OTASKS = H // ROWS  # 512
+O_ROUNDS = OTASKS // C.BLOCKS  # 2 tiles a CTA
+CORE_ROW = CORE + gemv.LDS_PAD  # bf16 a padded core row in LDS
+SPLIT = C.WAVES // O_ROUNDS  # 8 waves a tile
+OWNER_COLS = H // TP  # 2048 columns a rank owns after the reduce-scatter
+
+
+def ar_pairs(s):
+    """One parity's AR region: [src rank][token][column pair]."""
+    return TP * s * H // 2
+
+
+def owner_of_tile(rg):
+    return (rg * ROWS) // OWNER_COLS
+
+
+def o_loads(c, bid):
+    """This wave's chunks of its tile (``bid + BLOCKS * (wave // SPLIT)``): issue before ``load_core``."""
+    lane, wave = c["lane"], c["wave"]
+    j = wave // SPLIT
+    rg = bid + C.BLOCKS * j
+    return gemv.loads(lane, wave % SPLIT, c["args"]["w_o"], rg * ROWS, CORE, waves=SPLIT, nbytes=H * CORE * 2)
+
+
+@traced
+def load_core(c):
+    """The core rows (T x 2048 bf16, rows ``CORE`` apart) -> LDS, rows padded."""
+    gemv.rows_to_lds(c["tid"], c["args"]["core"], CORE, c["S"], c["xl"], CORE_ROW)
+
+
+@traced
+def _publish_tiles(c, bid, owner_only):
+    """Thread (tile j, token, 4-row group): its tile's wave sums in wave order -> bf16 -> AR#1."""
+    s, tid, red = c["S"], c["tid"], c["red"]
+    per_tile = s * (ROWS // 4)
+    if tid < O_ROUNDS * per_tile:
+        j = tid // per_tile
+        tt = (tid % per_tile) // (ROWS // 4)
+        rq = tid % (ROWS // 4)
+        vals = []
+        for d in range_constexpr(4):
+            r = 4 * rq + d
+            tot = fx.Float32(0.0)
+            for w in range_constexpr(SPLIT):
+                tot = tot + fx.ptr_load(red + C.acc_slot(j * SPLIT + w, r, tt))
+            vals.append(bf16_round(tot))
+        rg = bid + C.BLOCKS * j
+        at = (c["rank"] * s + tt) * H + rg * ROWS + 4 * rq
+        if const_expr(owner_only):
+            for jj in range_constexpr(O_ROUNDS):
+                if j == jj:
+                    c["put_bf"](c["ar_owner"][jj], at, vals)
+        else:
+            for p in range_constexpr(TP):
+                c["put_bf"](c["ar_peer"][p], at, vals)
+    gpu.barrier()
+
+
+@traced
+def _oproj_compute(c, bid):
+    s, lane, wave, red = c["S"], c["lane"], c["wave"], c["red"]
+    ops = o_loads(c, bid)
+    load_core(c)
+    acc = gemv.wmmas(lane, wave % SPLIT, c["xl"], CORE_ROW, CORE, s, ops, waves=SPLIT)
+    gemv.store_acc(red, wave, lane, acc)
+    gpu.barrier()
+
+
+@traced
+def stage_oproj_deep(c, bid):
+    """C1 (q8) o_proj: CTA ``bid``'s tiles bid, bid + 256 -> the column owners' AR#1 slots (reduce-scatter)."""
+    _oproj_compute(c, bid)
+    _publish_tiles(c, bid, True)
+
+
+@traced
+def stage_oproj(c, bid):
+    """Default-build o_proj: the same tiles -> every rank's AR#1 slot (push-all)."""
+    _oproj_compute(c, bid)
+    _publish_tiles(c, bid, False)
diff --git a/python/sglang/srt/rocm_muse_spark/mono_gfx1250/gemv/quarter_seam.py b/python/sglang/srt/rocm_muse_spark/mono_gfx1250/gemv/quarter_seam.py
new file mode 100644
index 0000000..3abb922
--- /dev/null
+++ b/python/sglang/srt/rocm_muse_spark/mono_gfx1250/gemv/quarter_seam.py
@@ -0,0 +1,105 @@
+"""C1's (q8) K2 seam on gfx1250 at TP4 (port of ``k2bundle/ops/stages/quarter_seam.py``).
+
+AR#1 runs as reduce-scatter + all-gather: CTA ``4 * token + quarter`` sums this rank's 512 columns of the quarter
+over the four ranks in rank order, rounds to bf16 and all-gathers the bf16 x and its per-slice (128-column) sums
+of squares.  The two norms of a token then run in one CTA, so neither needs a cross-CTA rendezvous.
+
+Lane layout: a wave32 owns a 128-column slice, a lane 4 columns (two bf16 pairs, one 16 B mailbox load).
+"""
+
+import flydsl.expr as fx
+from aiter.ops.flydsl.kernels import buffer_ops as bo
+from flydsl.expr import gpu, range_constexpr
+from flydsl.expr.typing import T
+
+from . import common as C
+from .common import CM_DEV_ST, bf16_pair, bf16_round, bf_hi, bf_lo, drain_stores, hw_rsq, rsrc, traced, wave_sum
+from .common import fma as _fma
+from .seam_b import COLS, LANE_COLS, H, TP, f32_of, sq4
+
+OWNER_COLS = H // TP  # 2048 columns a rank sums
+OWNER_PART = OWNER_COLS // 4  # 512 columns a CTA (four CTAs a token)
+OWNER_WAVES = OWNER_PART // COLS  # 4 waves a CTA, a slice each
+SEAM_SLICES = H // COLS // C.WAVES  # 4 slices a wave (16 waves cover the row)
+NSL_ROW = H // COLS  # 64
+
+
+@traced
+def stage_ar_owner_sum(c, bid):
+    """This rank's columns of token ``bid // 4``, quarter ``bid % 4``: the four ranks' bf16 partials summed in rank
+    order and rounded to bf16, all-gathered to every rank's XG, with the slice's sum of squares to every XSQ."""
+    tid, s = c["tid"], c["S"]
+    token, part = bid // 4, bid % 4
+    if tid < OWNER_PART // LANE_COLS:
+        col = c["rank"] * OWNER_COLS + part * OWNER_PART + LANE_COLS * tid
+        ar = c["poll"]([(c["ar_own"], ((src * s + token) * H + col) // 2, 2) for src in range(TP)])
+        xs, words = [], []
+        for p in range_constexpr(2):
+            lo, hi = bf_lo(ar[0][p]), bf_hi(ar[0][p])
+            for src in range_constexpr(1, TP):
+                lo = lo + bf_lo(ar[src][p])
+                hi = hi + bf_hi(ar[src][p])
+            x0, x1 = bf16_round(lo), bf16_round(hi)
+            xs += [x0, x1]
+            words.append(bf16_pair(x0, x1).bitcast(fx.Int32))
+        for p in range_constexpr(TP):
+            c["put_words"](c["peer"]["xg"][p], (token * H + col) // 2, words)
+        sq = wave_sum(sq4(xs))
+        if c["lane"] == 0:
+            j = c["rank"] * (OWNER_COLS // COLS) + (part * OWNER_PART) // COLS + c["wave"]
+            for p in range_constexpr(TP):
+                c["put"](c["peer"]["xsq"][p], token * NSL_ROW + j, sq)
+
+
+@traced
+def stage_seam_token(c, token):
+    """The q8 seam for one token in one CTA.  Wave w, slice j = 4 w + i, lane l: columns 128 j + 4 l .. + 3.
+    rstd1 from the owners' slice sums (XSQ); the slice sums of n^2 go through LDS, both totals reduced the same
+    way (lane l: slices l and l + 32, added, then the wave32 butterfly)."""
+    lane, wave, red = c["lane"], c["wave"], c["red"]
+    a = c["args"]
+    js = [wave * SEAM_SLICES + i for i in range(SEAM_SLICES)]
+    cols = [j * COLS + LANE_COLS * lane for j in js]
+    es = [token * H + col for col in cols]
+    sv = [fx.Vector(bo.buffer_load(rsrc(a["stream_a"]), e, vec_width=4, dtype=T.f32)) for e in es]
+    al = [fx.Vector(bo.buffer_load(rsrc(a["alpha_a"]), col, vec_width=4, dtype=T.f32)) for col in cols]
+    be = [fx.Vector(bo.buffer_load(rsrc(a["beta_a"]), col, vec_width=4, dtype=T.f32)) for col in cols]
+    wf = [fx.Vector(bo.buffer_load(rsrc(a["w_fn"]), col // 2, vec_width=2, dtype=T.i32)) for col in cols]
+    xs = c["poll"]([(c["peer"]["xg_own"], (token * H + col) // 2, 2) for col in cols])
+    if wave == 0:
+        got = c["poll"](
+            [(c["peer"]["xsq_own"], token * NSL_ROW + lane, 1), (c["peer"]["xsq_own"], token * NSL_ROW + lane + 32, 1)]
+        )
+        total = wave_sum(f32_of(got[0][0]) + f32_of(got[1][0]))
+        if lane == 0:
+            fx.ptr_store(hw_rsq(total * fx.Float32(1.0 / H) + fx.Float32(c["eps_attn"])), red)
+    gpu.barrier()
+    r1 = fx.ptr_load(red)
+    ns = []
+    for i in range_constexpr(SEAM_SLICES):
+        x = [bf_lo(xs[i][0]), bf_hi(xs[i][0]), bf_lo(xs[i][1]), bf_hi(xs[i][1])]
+        n = [_fma(al[i][k], sv[i][k], be[i][k] * (x[k] * r1)) for k in range(4)]
+        bo.buffer_store(fx.Vector.from_elements(n, fx.Float32), rsrc(a["stream_out"]), es[i])
+        sq2 = wave_sum(sq4(n))
+        if lane == 0:
+            fx.ptr_store(sq2, red + (NSL_ROW + js[i]))
+        ns.append(n)
+    gpu.barrier()
+    if wave == 0:
+        total2 = wave_sum(fx.ptr_load(red + (NSL_ROW + lane)) + fx.ptr_load(red + (NSL_ROW + 32 + lane)))
+        if lane == 0:
+            fx.ptr_store(hw_rsq(total2 * fx.Float32(1.0 / H) + fx.Float32(c["eps_ffn"])), red + 1)
+    gpu.barrier()
+    r2 = fx.ptr_load(red + 1)
+    for i in range_constexpr(SEAM_SLICES):
+        n = ns[i]
+        wv = [bf_lo(wf[i][0]), bf_hi(wf[i][0]), bf_lo(wf[i][1]), bf_hi(wf[i][1])]
+        y = [(n[k] * r2) * (wv[k] + fx.Float32(1.0)) for k in range(4)]
+        xw = fx.Vector.from_elements(y, fx.Float32).to(fx.BFloat16).bitcast(fx.Int32)
+        bo.buffer_store(xw, rsrc(c["xbuf"]), es[i] // 2, cache_modifier=CM_DEV_ST)
+    # Drain the x rows, then this token's four K-quarter flags.
+    drain_stores()
+    gpu.barrier()
+    if c["tid"] < 4:
+        c["put"](c["xrdy"], token * 4 + c["tid"], fx.Int32(1))
+    gpu.barrier()
diff --git a/python/sglang/srt/rocm_muse_spark/mono_gfx1250/gemv/seam.py b/python/sglang/srt/rocm_muse_spark/mono_gfx1250/gemv/seam.py
new file mode 100644
index 0000000..688711b
--- /dev/null
+++ b/python/sglang/srt/rocm_muse_spark/mono_gfx1250/gemv/seam.py
@@ -0,0 +1,85 @@
+"""K1 stage 1a, seam A, on gfx1250 (port of ``k2bundle/ops/stages/seam.py``): the previous layer's FFN boundary
+closed and this layer's pre-QKV norm, as ``fused_norm_residual_norm_fwd`` computes them::
+
+    xh       = branch * (w_pf + 1)                      (weight-first post norm)
+    stream_a = alpha * stream + beta * xh * rsqrt(mean(xh^2) + post_eps)
+    attn_in  = bf16(stream_a * rsqrt(mean(stream_a^2) + eps) * (w_qn + 1))
+
+Each of the 64 slice tasks owns 128 columns; wave = token, lane = 4 columns.  Rounding follows the Triton kernel
+elementwise (fp32 math, the weight added in fp32, ``beta * y + alpha * stream`` as one fma, rsqrt then the
+weight, one bf16 rounding).  gfx950's reproduction of Triton's 16-wave ownership of the post-norm sum is dropped
+(no gfx950 reference on this GPU): both 8192-wide sums are a slice's wave32 partial (lane (c0^2 + c1^2) +
+(c2^2 + c3^2), butterfly) through a mailbox, then every slice sums the 64 partials in one fixed order.
+``stream_a`` is stored fp32 (K2's residual_state input); the bf16 ``attn_in`` columns go to the x rows at
+device scope, then the slice's XRDY flag.
+"""
+
+import flydsl.expr as fx
+from aiter.ops.flydsl.kernels import buffer_ops as bo
+from flydsl.expr import gpu
+from flydsl.expr.typing import T
+
+from . import common as C
+from .common import CM_DEV_ST, bf_hi, bf_lo, hw_rsq, publish, rsrc, traced, wave_sum
+from .common import fma as _fma
+from .seam_b import sq4
+
+HIDDEN = C.H
+NS = 64
+COLS = HIDDEN // NS
+LANE_COLS = COLS // C.WAVE  # 4
+
+
+def ld_bf4(ptr, i):
+    """bf16 elements i .. i + 4 (i a multiple of 4) as four f32."""
+    w = fx.Vector(bo.buffer_load(rsrc(ptr), i // 2, vec_width=2, dtype=T.i32))
+    return [bf_lo(w[0]), bf_hi(w[0]), bf_lo(w[1]), bf_hi(w[1])]
+
+
+def ld_f4(ptr, i):
+    v = fx.Vector(bo.buffer_load(rsrc(ptr), i, vec_width=4, dtype=T.f32))
+    return [v[k] for k in range(4)]
+
+
+@traced
+def _row_rstd(c, region, eps, t):
+    """rsqrt(mean + eps) of token t from the 64 slices' partials at ``region`` [slice][t]."""
+    s_rows, lane = c["T"], c["lane"]
+    got = c["poll"]([(region, lane * s_rows + t, 1), (region, (lane + C.WAVE) * s_rows + t, 1)])
+    tot = wave_sum(got[0][0].bitcast(fx.Float32) + got[1][0].bitcast(fx.Float32))
+    return hw_rsq(tot * fx.Float32(1.0 / HIDDEN) + fx.Float32(eps))
+
+
+@traced
+def stage_seam(c, s):
+    """Post norm, residual mix, pre norm, then XRDY[s]."""
+    s_rows, lane, wave = c["T"], c["lane"], c["wave"]
+    a = c["args"]
+    mine = wave < s_rows
+    t = fx.min(wave, s_rows - 1)
+    col = s * COLS + LANE_COLS * lane
+    e = t * HIDDEN + col
+    br = ld_bf4(a["branch_in"], e)
+    st = ld_f4(a["stream_in"], e)
+    wpf = ld_bf4(a["w_pf"], col)
+    al = ld_f4(a["alpha_f"], col)
+    be = ld_f4(a["beta_f"], col)
+    wqn = ld_bf4(a["w_qn"], col)
+    xh = [br[k] * (wpf[k] + fx.Float32(1.0)) for k in range(4)]
+    sq = wave_sum(sq4(xh))
+    if mine & (lane == 0):
+        c["put"](c["p1"], s * s_rows + t, sq)
+    r1 = _row_rstd(c, c["p1"], c["post_eps"], t)
+    sv = [_fma(be[k], xh[k] * r1, al[k] * st[k]) for k in range(4)]
+    if mine:
+        bo.buffer_store(fx.Vector.from_elements(sv, fx.Float32), rsrc(a["stream_a"]), e)
+    sq2 = wave_sum(sq4(sv))
+    if mine & (lane == 0):
+        c["put"](c["p2"], s * s_rows + t, sq2)
+    r2 = _row_rstd(c, c["p2"], c["eps"], t)
+    y = [(sv[k] * r2) * (wqn[k] + fx.Float32(1.0)) for k in range(4)]
+    words = fx.Vector.from_elements(y, fx.Float32).to(fx.BFloat16).bitcast(fx.Int32)
+    if mine:
+        bo.buffer_store(words, rsrc(c["xbuf"]), e // 2, cache_modifier=CM_DEV_ST)
+    publish(c["put"], c["xrdy"], s, fx.Int32(1), c["tid"] == 0)
+    gpu.barrier()
diff --git a/python/sglang/srt/rocm_muse_spark/mono_gfx1250/gemv/seam_b.py b/python/sglang/srt/rocm_muse_spark/mono_gfx1250/gemv/seam_b.py
new file mode 100644
index 0000000..559f2cb
--- /dev/null
+++ b/python/sglang/srt/rocm_muse_spark/mono_gfx1250/gemv/seam_b.py
@@ -0,0 +1,84 @@
+"""K2's seam B on gfx1250 at TP4 (port of ``k2bundle/ops/stages/seam_b.py``): the o_proj all-reduce and
+production's ``norm_residual_then_norm`` between the attention and the MoE, per 128-column slice.  C1 (q8) runs
+``quarter_seam`` instead; this default-build path and the constants ``quarter_seam`` imports are kept.
+
+Slice j (CTA j < 64), wave = token, lane = 4 columns (two bf16 pairs):
+
+    attn  = bf16(sum over ranks 0..3, in order, of the bf16 o_proj partials)
+    s'    = fma(alpha_a, s, beta_a (attn rsqrt(mean(attn^2) + eps_attn)))   -> ``stream_out`` (fp32)
+    x     = bf16((s' rsqrt(mean(s'^2) + eps_ffn)) (w_fn + 1))                -> x rows (device scope), XRDY[j]
+
+The 8192-wide sums of squares: a slice's per-token partial (lane: (c0^2 + c1^2) + (c2^2 + c3^2), then the wave32
+butterfly) -> MSQ; every slice reads all 64 (lane l: slices l and l + 32, added, then the butterfly), so every
+slice applies the same rstd.
+"""
+
+import flydsl.expr as fx
+from aiter.ops.flydsl.kernels import buffer_ops as bo
+from flydsl.expr import gpu, range_constexpr
+from flydsl.expr.typing import T
+
+from . import common as C
+from .common import CM_DEV_ST, bf16_round, bf_hi, bf_lo, hw_rsq, publish, rsrc, traced, wave_sum
+from .common import fma as _fma
+
+TP = C.TP
+H = C.H
+COLS = 128
+NSL = H // COLS  # 64 slices
+LANE_COLS = COLS // C.WAVE  # 4
+
+
+def f32_of(w):
+    return w.bitcast(fx.Float32)
+
+
+def sq4(v):
+    return (v[0] * v[0] + v[1] * v[1]) + (v[2] * v[2] + v[3] * v[3])
+
+
+def slice_total(c, region, s, t):
+    """Sum of the 64 slices' partials of token t at ``region`` [slice][t] (lane l: l and l + 32)."""
+    lane = c["lane"]
+    got = c["poll"]([(region, lane * s + t, 1), (region, (lane + C.WAVE) * s + t, 1)])
+    return wave_sum(f32_of(got[0][0]) + f32_of(got[1][0]))
+
+
+@traced
+def stage_seam(c, j):
+    s, lane, wave = c["S"], c["lane"], c["wave"]
+    a = c["args"]
+    live = wave < s
+    t = fx.min(wave, s - 1)
+    col = j * COLS + LANE_COLS * lane
+    e = t * H + col
+    sv = fx.Vector(bo.buffer_load(rsrc(a["stream_a"]), e, vec_width=4, dtype=T.f32))
+    al = fx.Vector(bo.buffer_load(rsrc(a["alpha_a"]), col, vec_width=4, dtype=T.f32))
+    be = fx.Vector(bo.buffer_load(rsrc(a["beta_a"]), col, vec_width=4, dtype=T.f32))
+    wf = fx.Vector(bo.buffer_load(rsrc(a["w_fn"]), col // 2, vec_width=2, dtype=T.i32))
+    ws = c["poll"]([(c["ar_own"], ((src * s + t) * H + col) // 2, 2) for src in range(TP)])
+    xs = []
+    for p in range_constexpr(2):
+        lo, hi = bf_lo(ws[0][p]), bf_hi(ws[0][p])
+        for src in range_constexpr(1, TP):
+            lo = lo + bf_lo(ws[src][p])
+            hi = hi + bf_hi(ws[src][p])
+        xs += [bf16_round(lo), bf16_round(hi)]
+    sq = wave_sum(sq4(xs))
+    if live & (lane == 0):
+        c["put"](c["msq1"], j * s + t, sq)
+    r1 = hw_rsq(slice_total(c, c["msq1"], s, t) * fx.Float32(1.0 / H) + fx.Float32(c["eps_attn"]))
+    n = [_fma(al[k], sv[k], be[k] * (xs[k] * r1)) for k in range(4)]
+    if live:
+        bo.buffer_store(fx.Vector.from_elements(n, fx.Float32), rsrc(a["stream_out"]), e)
+    sq2 = wave_sum(sq4(n))
+    if live & (lane == 0):
+        c["put"](c["msq2"], j * s + t, sq2)
+    r2 = hw_rsq(slice_total(c, c["msq2"], s, t) * fx.Float32(1.0 / H) + fx.Float32(c["eps_ffn"]))
+    wv = [bf_lo(wf[0]), bf_hi(wf[0]), bf_lo(wf[1]), bf_hi(wf[1])]
+    y = [(n[k] * r2) * (wv[k] + fx.Float32(1.0)) for k in range(4)]
+    xw = fx.Vector.from_elements(y, fx.Float32).to(fx.BFloat16).bitcast(fx.Int32)
+    if live:
+        bo.buffer_store(xw, rsrc(c["xbuf"]), e // 2, cache_modifier=CM_DEV_ST)
+    publish(c["put"], c["xrdy"], j, fx.Int32(1), c["tid"] == 0)
+    gpu.barrier()
diff --git a/python/sglang/srt/rocm_muse_spark/mono_gfx1250/k2.py b/python/sglang/srt/rocm_muse_spark/mono_gfx1250/k2.py
new file mode 100644
index 0000000..5677ea2
--- /dev/null
+++ b/python/sglang/srt/rocm_muse_spark/mono_gfx1250/k2.py
@@ -0,0 +1,400 @@
+"""K2 on MI455X (gfx1250) at TP4 / EP1: one Muse Spark sparse decoder layer from the attention's core output
+(o_proj's input) to the MoE branch, one persistent launch a layer and TP rank, every TP collective inside the
+kernel. Port of the MI355X ``k2bundle/ops/k2.py`` (TP8 / EP1, q8 schedule); stages from the helpers' modules
+(``port/gemv`` o_proj / seam / router / pooler / route / unpooler / gather, ``port/moe`` xq / UG / down /
+finalize), sync from ``port/sync``. Contract: ``port/INTERFACE.md``.
+
+Width: T = 8 rows only (C1 verify step). Other widths take the served path (``step_disable_reason``).
+
+CTA roles (256 CTAs x 512 threads, one a CU, all co-resident). No CTA waits on a stage later in its own program:
+
+    CTAs 0 .. 255     o_proj: tiles bid, bid + 256 (16 rows x K 2048 each) -> AR#1 reduce-scatter to the owners
+    CTAs 0 .. 31      AR#1 owner sum (quarter seam) -> XG / XSQ; CTAs 0 .. 7 then seam token t -> stream_out, x, XRDY
+    CTAs 0 .. 7       route token t (after the router's RLOG_PARTS) -> ROUTE
+    CTAs 32 .. 95     router: 64 q8 tasks (16 experts x K quarter x token pair), weights in flight before XRDY
+    CTAs 0 .. 255     pooler task bid (64 groups x K quarter) -> POOL all-gather (CTAs 0 .. 31 after the seam)
+    CTAs 8 .. 15      xq token t: POOL row -> pre_expert_norm -> MXFP8 -> XQ / XSC (+ XQRDY)
+    every CTA         route table (LDS); UG tasks u = bid + 256 i < |U| 32 (slot, 32-column group)
+    every wave        down tasks v = 16 bid + wave + 4096 i < |U| 256 (slot, 16-row MH tile) -> YR (row owner)
+    CTAs 192 .. 255   finalize (owned row tl, 128-column slice j) -> FIN rows (plain) + FRDY on every rank
+    CTAs 0 .. 127     unpooler task bid (16 branch columns) -> BR all-gather; W_unpool issued before FRDY
+    CTAs 128 .. 191   gather: BR -> ``branch_out``
+    every CTA         finish consensus (fan-in tree, then the 4 ranks' done pairs)
+"""
+
+import os
+from dataclasses import dataclass
+
+import flydsl.compiler as flyc
+import flydsl.expr as fx
+from flydsl.expr import const_expr, gpu
+from flydsl.expr.typing import Int32, Int64
+
+from sglang.srt.rocm_muse_spark.mono_gfx1250 import consts as K
+from sglang.srt.rocm_muse_spark.mono_gfx1250.common.ops import ld_i32, load_ptr64, traced, uniform, vm_wait
+from sglang.srt.rocm_muse_spark.mono_gfx1250.gemv import moe_dense as MD
+from sglang.srt.rocm_muse_spark.mono_gfx1250.gemv import oproj, quarter_seam
+from sglang.srt.rocm_muse_spark.mono_gfx1250.moe import moe as X
+from sglang.srt.rocm_muse_spark.mono_gfx1250.sync.abi import K2_DONE_BYTES, K2_DONE_OFFSET
+from sglang.srt.rocm_muse_spark.mono_gfx1250.sync.debug import region_ids
+from sglang.srt.rocm_muse_spark.mono_gfx1250.sync.epoch import EPOCH_TAG_PERIOD, TAG_SLOTS
+from sglang.srt.rocm_muse_spark.mono_gfx1250.sync.memmodel import CM_DEV
+from sglang.srt.rocm_muse_spark.mono_gfx1250.sync.plan import KernelAbi, enter_stage, key_tuple, pair_layout, source_digest
+from sglang.srt.rocm_muse_spark.mono_gfx1250.sync.ranks import peer_bases
+from sglang.srt.rocm_muse_spark.mono_gfx1250.sync.sync import Mailbox, import_alarms, preg, publish, shift, sreg
+
+TP = K.TP
+BLOCKS = K.BLOCKS
+THREADS = K.THREADS
+WAVES = K.WAVES
+MAX_TOKENS = K.MAX_TOKENS
+K2_SLOT0 = 128  # K2 of layer i is mailbox slot 128 + i
+
+# ---- CTA roles (T = 8)
+OWNER0, OWNER_CTAS = 0, 4 * MAX_TOKENS  # AR#1 owner sum: 32 CTAs (P4: four a token)
+R0 = OWNER0 + OWNER_CTAS  # 32: router CTAs
+P0 = 0  # pooler task p on CTA p
+XQ0 = MAX_TOKENS  # 8: xq CTAs (seam CTAs after their pooler task)
+FIN_CTAS = (MAX_TOKENS // TP) * X.FIN_SLICES  # 64: (owned row, slice)
+FIN0 = BLOCKS - FIN_CTAS  # 192
+U0 = 0  # unpooler CTAs
+G0 = MD.UP_TASKS  # 128: gather CTAs
+UG_GROUPS = K.RI // 32  # 32 UG tasks a slot
+DOWN_TILES = K.MH // K.ROWS  # 256 down wave-tasks a slot
+assert MD.P_TASKS == BLOCKS
+assert R0 + MD.R_TASKS_Q8 <= BLOCKS
+assert G0 + MD.GATHER_TASKS <= FIN0 and U0 + MD.UP_TASKS <= G0
+assert oproj.OTASKS == 2 * BLOCKS
+
+FINISH_FANIN = 8
+FINISH_GROUPS = BLOCKS // FINISH_FANIN  # 32
+FINISH_ROOTS = FINISH_GROUPS // FINISH_FANIN  # 4
+
+# ---- regions
+_PEER_PAIRS = {
+    "ar": oproj.ar_pairs(MAX_TOKENS),
+    **MD.peer_pairs(MAX_TOKENS),  # rlog, rlog_parts, pool, br
+    "xg": MAX_TOKENS * K.H // 2,
+    "xsq": MAX_TOKENS * 64,
+    "yr": TP * MAX_TOKENS * K.TOPK * K.MH // 2,  # [src][t][k][MH] bf16 pairs (owned rows written)
+    "frdy": MAX_TOKENS * X.FIN_SLICES,  # row t, slice j
+}
+_PEER_PLAIN = {"fin": MAX_TOKENS * K.MH * 2}  # [t][MH] bf16, written by the row owners
+_SCRATCH_PAIRS = {
+    "msq1": 64 * MAX_TOKENS,
+    "msq2": 64 * MAX_TOKENS,
+    "xrdy": max(64, 4 * MAX_TOKENS),
+    "p1": 64 * MAX_TOKENS,
+    "p2": 64 * MAX_TOKENS,
+    "rpart": MD.R_TASKS * MAX_TOKENS * WAVES,
+    "ppart": MD.P_TASKS * MAX_TOKENS * K.ROWS,
+    "route": MAX_TOKENS * 2 * K.TOPK,
+    "xqrdy": MAX_TOKENS,
+    "ugrdy": X.MAX_U * UG_GROUPS,
+    "fmsq": MAX_TOKENS * K.TOPK * X.FIN_SLICES,
+    "finish": BLOCKS + FINISH_GROUPS + FINISH_ROOTS,
+}
+_SCRATCH_PLAIN = dict(X.scratch_plain(MAX_TOKENS, "a8"))  # xqb, xscb, interb, iscb (fmsq: pairs above)
+_SCRATCH_PLAIN.pop("fmsq", None)
+_SCRATCH_PLAIN["xrow"] = MAX_TOKENS * K.H * 2
+
+REGIONS = tuple(_PEER_PAIRS) + tuple(_SCRATCH_PAIRS) + ("done",)
+
+_SOURCES = source_digest("common", "sync", "gemv", "moe", "consts.py", "k2.py")
+_STREAM = fx.Stream(None)
+
+
+def _layout(pairs, plain, align=256):
+    lay = pair_layout(pairs.items(), align=align)
+    end = max(o + n for o, n in lay.values())
+    for name, nbytes in plain.items():
+        off = (end + align - 1) // align * align
+        lay[name] = (off, nbytes)
+        end = off + nbytes
+    return lay, (end + align - 1) // align * align
+
+
+def peer_layout() -> dict:
+    """One parity's peer regions (name -> (byte offset, bytes))."""
+    return _layout(_PEER_PAIRS, _PEER_PLAIN)[0]
+
+
+def _half() -> int:
+    return _layout(_PEER_PAIRS, _PEER_PLAIN)[1]
+
+
+def peer_bytes() -> int:
+    """Both parities' peer bytes (past the runner's PEER_HEAD)."""
+    return 2 * _half()
+
+
+def scratch_layout() -> dict:
+    return _layout(_SCRATCH_PAIRS, _SCRATCH_PLAIN, align=16)[0]
+
+
+def scratch_bytes() -> int:
+    return _layout(_SCRATCH_PAIRS, _SCRATCH_PLAIN, align=16)[1]
+
+
+# ---- build key / ABI
+@dataclass(frozen=True)
+class K2Build:
+    tokens: int = MAX_TOKENS
+    eps_post_attn: float = K.EPS_POST_ATTN
+    eps_ffn: float = K.EPS_FFN
+    eps_pre_expert: float = K.EPS_PRE_EXPERT
+    eps_post_expert: float = K.EPS_POST_EXPERT
+    router_output_multiplier: float = K.ROUTER_MULT
+    act: str = "a8"
+    ug_ksplit: int = 8  # in-CTA split-K of a UG task (16 waves: 2 tiles x 8 K parts)
+    ug_prefetch: int = 4
+    down_prefetch: int = 8
+    fault_rank: int = -1
+    fault_epoch: int = 0
+    fault_layer: int = 0
+    fault_ticks: int = 0
+
+    def __post_init__(self):
+        if self.tokens != MAX_TOKENS:
+            raise ValueError(f"gfx1250 K2 supports T = {MAX_TOKENS} only (got {self.tokens})")
+        if self.act not in ("a8", "a4"):
+            raise ValueError(self.act)
+
+
+def make_key(**kw) -> K2Build:
+    return K2Build(**kw)
+
+
+ABI = KernelAbi(
+    (
+        "core", "stream_a", "w_o", "alpha_a", "beta_a", "w_fn", "w_router", "expert_bias", "w_pool", "w_pre",
+        "w13", "w13s", "w2", "w2s", "w_post", "w_unpool", "stream_out", "branch_out", "scratch", "peers", "rank",
+        "epoch", "layer", "health", "alarm", "tl",
+    )
+)  # fmt: skip
+
+
+def step_tag(epoch, slot):
+    """The launch's mailbox tag (epoch and slot packed; never 0)."""
+    return (epoch % EPOCH_TAG_PERIOD) * TAG_SLOTS + slot + 1
+
+
+def step_disable_reason(rows: int) -> str | None:
+    if rows != MAX_TOKENS:
+        return f"K2 gfx1250 runs T={MAX_TOKENS} only (step has {rows} rows)"
+    return None
+
+
+@traced
+def finish_consensus(c, done, health, alarm):
+    """Keep CTA 0 live until every local CTA and every TP rank reached the tail (MI355X default fan-in tree)."""
+    tid, bid = c["tid"], c["bid"]
+    publish(c["put"], c["finish"], bid, 1, tid == 0)
+    if (bid < FINISH_GROUPS) & (tid == 0):
+        lo = bid * FINISH_FANIN
+        c["poll_terminal"]([(c["finish"], lo + i, 1) for i in range(FINISH_FANIN)])
+        c["put"](c["finish"], BLOCKS + bid, 1)
+    if (bid < FINISH_ROOTS) & (tid == 0):
+        lo = BLOCKS + bid * FINISH_FANIN
+        c["poll_terminal"]([(c["finish"], lo + i, 1) for i in range(FINISH_FANIN)])
+        c["put"](c["finish"], BLOCKS + FINISH_GROUPS + bid, 1)
+    if (bid == 0) & (tid == 0):
+        c["poll_terminal"]([(c["finish"], BLOCKS + FINISH_GROUPS + i, 1) for i in range(FINISH_ROOTS)])
+        c["put"](done, c["rank"], 1)
+        vm_wait()
+        c["poll_terminal"]([(done, r, 1) for r in range(TP)])
+        import_alarms(health, alarm, c["rank"], TP)
+
+
+# ---- build
+_BUILDS: dict = {}
+
+
+def _make(key: K2Build):
+    s = key.tokens
+    lay = scratch_layout()
+    play = peer_layout()
+    half = _half()
+    xrow_max = max(oproj.CORE_ROW, MD.EARLY_K + 8, K.MH + 8)
+    nk = (X.MAX_U + 1) * 8
+
+    @fx.struct
+    class RouteLds:
+        ids: fx.Array[fx.Int32, s * K.TOPK, 16]
+        fl: fx.Array[fx.Int32, s * K.TOPK, 16]
+        expert: fx.Array[fx.Int32, X.MAX_U + 1, 16]
+        kof: fx.Array[fx.Int32, nk, 16]
+
+    @fx.struct
+    class Smem:
+        red: fx.Array[fx.Float32, WAVES * 256, 16]
+        av: fx.Array[fx.Float32, THREADS, 16]
+        xl: fx.Array[fx.Int32, s * xrow_max // 2, 16]
+        kred: fx.Array[fx.Float32, 2 * key.ug_ksplit * 2 * 8 * 32, 16]
+        amx: fx.Array[fx.Float32, 32, 16]
+
+    keyed = key_tuple(key, _SOURCES)
+    name = f"muse_mono_k2g_s{s}_{key.act}"
+    if key.fault_rank >= 0:
+        name += f"_f{key.fault_rank}_{key.fault_epoch}_{key.fault_layer}_{key.fault_ticks}"
+    rids = region_ids(REGIONS)
+
+    @flyc.kernel(name=name, known_block_size=[THREADS, 1, 1])
+    def k2(
+        core: Int64, stream_a: Int64, w_o: Int64, alpha_a: Int64, beta_a: Int64, w_fn: Int64, w_router: Int64,
+        expert_bias: Int64, w_pool: Int64, w_pre: Int64, w13: Int64, w13s: Int64, w2: Int64, w2s: Int64,
+        w_post: Int64, w_unpool: Int64, stream_out: Int64, branch_out: Int64, scratch: Int64, peers: Int64,
+        rank: Int32, epoch: Int64, layer: Int32, health: Int64, alarm: Int64, tl: Int64,
+    ):  # fmt: skip
+        _ = keyed
+        tid = fx.thread_idx.x
+        bid = fx.block_idx.x
+        alloc = fx.SharedAllocator()
+        lds = alloc.allocate(Smem).peek()
+        rl = alloc.allocate(RouteLds).peek()
+        ep = uniform(ld_i32(epoch, 0))
+        mb = Mailbox(step_tag(ep, K2_SLOT0 + layer) - 1, health, alarm, rids)
+        par = ep % 2
+        bases = peer_bases(peers, TP)
+        own = load_ptr64(peers, rank)
+        output_head = alarm - fx.Int64(rank) * 4
+        done = preg(output_head, K2_DONE_OFFSET, "done", K2_DONE_BYTES)
+        poff = fx.Int64(par) * half
+        peer = {}
+        for region in _PEER_PAIRS:
+            off, extent = play[region]
+            peer[region] = [shift(preg(b, off, region, extent), poff) for b in bases]
+            peer[region + "_own"] = shift(preg(own, off, region, extent), poff)
+        args = dict(
+            core=core, stream_a=stream_a, w_o=w_o, alpha_a=alpha_a, beta_a=beta_a, w_fn=w_fn, w_router=w_router,
+            expert_bias=expert_bias, w_pool=w_pool, w_pre=w_pre, w13=w13, w13s=w13s, w2=w2, w2s=w2s,
+            w_post=w_post, w_unpool=w_unpool, stream_out=stream_out, branch_out=branch_out,
+        )  # fmt: skip
+        fin_off = play["fin"][0]
+        c = {
+            "S": s, "T": s, "tid": tid, "bid": bid, "lane": tid % K.LANES, "wave": tid // K.LANES, "rank": rank,
+            "threads": THREADS, "act": key.act, "nt": 1, "ksplit": key.ug_ksplit, "prefetch": key.ug_prefetch,
+            "dprefetch": key.down_prefetch,
+            "quarter_seam": True, "rlog_parts": True, "experimental_two_cta": True,
+            "eps_attn": key.eps_post_attn, "eps_ffn": key.eps_ffn, "eps_pre": key.eps_pre_expert,
+            "eps_post": key.eps_post_expert, "router_output_multiplier": key.router_output_multiplier,
+            "put": mb.put, "put_bf": mb.put_bf, "put_words": mb.put_words, "poll": mb.poll,
+            "poll_terminal": mb.poll_terminal,
+            "red": lds.red.ptr, "av": lds.av.ptr, "xl": lds.xl.ptr, "kred": lds.kred.ptr, "amx": lds.amx.ptr,
+            "rt": {"ids": rl.ids.ptr, "fl": rl.fl.ptr, "expert": rl.expert.ptr, "kof": rl.kof.ptr},
+            "peer": peer, "ar_peer": peer["ar"], "ar_own": peer["ar_own"],
+            "yr": peer["yr_own"], "yr_owner": peer["yr"], "frdy_peer": peer["frdy"], "frdy": peer["frdy_own"],
+            "fin": own + fx.Int64(fin_off) + poff,
+            "fin_peer": [b + fx.Int64(fin_off) + poff for b in bases],
+            "xbuf": scratch + fx.Int64(lay["xrow"][0]),
+            "args": args, "stamp": lambda k: None, "xcm": CM_DEV, "frdy_flags": s * X.FIN_SLICES,
+        }  # fmt: skip
+        for region in _SCRATCH_PAIRS:
+            c[region] = sreg(scratch, lay[region][0], region, lay[region][1])
+        for region in _SCRATCH_PLAIN:
+            c[region] = scratch + fx.Int64(lay[region][0])
+        off_ar, ext_ar = play["ar"]
+        c["ar_owner"] = [
+            shift(preg(load_ptr64(peers, oproj.owner_of_tile(bid + BLOCKS * j)), off_ar, "ar", ext_ar), poff)
+            for j in range(oproj.O_ROUNDS)
+        ]
+
+        # ---- o_proj (every CTA) -> AR#1 to the column owners
+        enter_stage("oproj")
+        oproj.stage_oproj_deep(c, bid)
+        # ---- router CTAs: weights in flight, then x
+        is_r = (bid >= R0) & (bid < R0 + MD.R_TASKS_Q8)
+        r_task = fx.max(fx.min(bid - R0, MD.R_TASKS_Q8 - 1), 0)
+        if is_r:
+            enter_stage("router")
+            ri = (r_task % MD.R_TASKS) // MD.R_PARTS
+            rq = r_task % MD.R_PARTS
+            MD.router_compute_pair(c, ri, rq, r_task // MD.R_TASKS, MD.router_loads(c, ri, rq))
+        # ---- seam B (CTAs 0 .. 31), route (0 .. 7)
+        if bid < OWNER_CTAS:
+            enter_stage("seam")
+            quarter_seam.stage_ar_owner_sum(c, bid)
+            if bid < s:
+                quarter_seam.stage_seam_token(c, bid)
+                enter_stage("route")
+                MD.stage_route(c, bid)
+        # ---- pooler task bid (every CTA)
+        enter_stage("pool")
+        pi = bid // MD.P_PARTS
+        pq = bid % MD.P_PARTS
+        MD.pool_compute(c, pi, pq, MD.pool_loads(c, pi, pq))
+        # ---- xq (CTAs 8 .. 15)
+        if (bid >= XQ0) & (bid < XQ0 + s):
+            enter_stage("xq")
+            X.stage_xq(c, bid - XQ0)
+        # ---- routed experts: UG (CTA tasks), down (wave tasks)
+        enter_stage("route_wait")
+        nu = X.load_route(c)
+        X.wait_xq(c)
+        enter_stage("ug")
+        n_ug = nu * UG_GROUPS
+        for i in range((X.MAX_U * UG_GROUPS + BLOCKS - 1) // BLOCKS):
+            u = bid + BLOCKS * i
+            if u < n_ug:
+                X.stage_ug(c, u // UG_GROUPS, u % UG_GROUPS)
+        enter_stage("down")
+        n_dn = nu * DOWN_TILES
+        v0 = bid * WAVES + c["wave"]
+        for i in range((X.MAX_U * DOWN_TILES + BLOCKS * WAVES - 1) // (BLOCKS * WAVES)):
+            v = v0 + BLOCKS * WAVES * i
+            if v < n_dn:
+                X.stage_down(c, v // DOWN_TILES, v % DOWN_TILES)
+        gpu.barrier()
+        # ---- finalize on the row owners (CTAs 192 .. 255); unpooler weights in flight first
+        up_live = (bid >= U0) & (bid < U0 + MD.UP_TASKS)
+        up_ops = MD.up_loads_masked(c, bid - U0, up_live)
+        if bid >= FIN0:
+            enter_stage("finalize")
+            f = bid - FIN0
+            X.stage_fin(c, f // X.FIN_SLICES, f % X.FIN_SLICES, 2)
+        # ---- unpooler (CTAs 0 .. 127), gather (128 .. 191)
+        if up_live:
+            enter_stage("up")
+            MD.stage_up(c, bid - U0, up_ops)
+        if (bid >= G0) & (bid < G0 + MD.GATHER_TASKS):
+            enter_stage("gather")
+            MD.stage_gather(c, bid - G0)
+        enter_stage("finish")
+        finish_consensus(c, done, health, alarm)
+
+    @flyc.jit
+    def launch(
+        core: Int64, stream_a: Int64, w_o: Int64, alpha_a: Int64, beta_a: Int64, w_fn: Int64, w_router: Int64,
+        expert_bias: Int64, w_pool: Int64, w_pre: Int64, w13: Int64, w13s: Int64, w2: Int64, w2s: Int64,
+        w_post: Int64, w_unpool: Int64, stream_out: Int64, branch_out: Int64, scratch: Int64, peers: Int64,
+        rank: Int32, epoch: Int64, layer: Int32, health: Int64, alarm: Int64, tl: Int64,
+        stream: fx.Stream = _STREAM,
+    ):  # fmt: skip
+        _ = keyed
+        k2(
+            core, stream_a, w_o, alpha_a, beta_a, w_fn, w_router, expert_bias, w_pool, w_pre, w13, w13s, w2, w2s,
+            w_post, w_unpool, stream_out, branch_out, scratch, peers, rank, epoch, layer, health, alarm, tl,
+        ).launch(grid=(BLOCKS,), block=(THREADS,), stream=stream)  # fmt: skip
+
+    ABI.check(k2, launch)
+    return launch
+
+
+def build(key: K2Build):
+    if key not in _BUILDS:
+        _BUILDS[key] = _make(key)
+    return _BUILDS[key]
+
+
+def k2_launch(key: K2Build, t: dict, rank: int, layer: int, epoch, peers, scratch, health, alarm, stream=None):
+    """Launch one layer's K2 on this rank. ``t``: the ABI tensors by name (``core`` .. ``branch_out``)."""
+    launch = build(key)
+    ptr = lambda x: x if isinstance(x, int) else x.data_ptr()  # noqa: E731
+    vals = [ptr(t[n]) for n in ABI.names[:18]]
+    st = fx.Stream(stream if stream is not None else 0)
+    launch(*vals, ptr(scratch), ptr(peers), rank, ptr(epoch), layer, ptr(health), ptr(alarm), 0, stream=st)
+
+
+if os.environ.get("K2G_PRINT_LAYOUT"):
+    print("peer", peer_layout(), "half", _half())
+    print("scratch", scratch_layout(), "bytes", scratch_bytes())
