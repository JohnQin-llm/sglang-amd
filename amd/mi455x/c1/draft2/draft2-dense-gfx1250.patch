diff --git a/python/sglang/kernels/ops/attention/muse_reduce_gate.py b/python/sglang/kernels/ops/attention/muse_reduce_gate.py
new file mode 100644
index 0000000000..c1c27f526d
--- /dev/null
+++ b/python/sglang/kernels/ops/attention/muse_reduce_gate.py
@@ -0,0 +1,183 @@
+"""AITER's split-KV ``reduce_segments`` with the Muse attention-output epilogue (per-head RMS norm + sigmoid gate).
+
+The segment merge is AITER's code unchanged (same loads, same reductions, same launch config). The merged head is
+rounded to the output dtype, then normalized and gated exactly as ``_rms_norm_gate_fwd_kernel`` does on that
+output (weightless norm, fp32 math), and stored in place of the plain attention output.
+"""
+
+import triton
+import triton.language as tl
+from aiter.ops.triton._triton_kernels.attention.unified_attention import (
+    find_seq_idx,
+    float8_info,
+    segment_range,
+)
+
+
+@triton.jit
+def reduce_segments_gate_norm(
+    output_ptr,  # [num_tokens, num_query_heads, head_size]
+    segm_output_ptr,
+    segm_max_ptr,
+    segm_expsum_ptr,
+    seq_lens_ptr,
+    num_seqs,
+    num_query_heads: tl.constexpr,
+    out_scale_ptr,
+    output_stride_0: tl.int64,
+    output_stride_1: tl.int64,
+    block_table_stride: tl.int64,
+    gate_ptr,  # grouped gate view [tokens, groups, heads_per_group * head_size]
+    stride_g0,
+    stride_g1,
+    norm_eps,
+    TILE_SIZE: tl.constexpr,
+    HEAD_SIZE: tl.constexpr,
+    HEAD_SIZE_PADDED: tl.constexpr,
+    V_HEAD_SIZE: tl.constexpr,
+    V_HEAD_SIZE_PADDED: tl.constexpr,
+    query_start_len_ptr,
+    BLOCK_Q: tl.constexpr,
+    NUM_SEGMENTS_PER_SEQ: tl.constexpr,
+    HEADS_PER_GROUP: tl.constexpr,
+    FP8_MIN: tl.constexpr = float8_info.min,
+    FP8_MAX: tl.constexpr = float8_info.max,
+    SEGMENT_BLOCK: tl.constexpr = 0,
+    BLOCK_D: tl.constexpr = 0,
+    SLIDING_WINDOW: tl.constexpr = 0,
+    WINDOW_SPLIT: tl.constexpr = False,
+):
+    query_token_idx = tl.program_id(0)
+    query_head_idx = tl.program_id(1)
+
+    seq_idx = find_seq_idx(
+        query_start_len_ptr, query_token_idx, num_seqs, BLOCK_Q, False
+    )
+    seq_len = tl.load(seq_lens_ptr + seq_idx)
+
+    query_len = 1
+    if WINDOW_SPLIT and SLIDING_WINDOW > 0:
+        query_len = tl.load(query_start_len_ptr + seq_idx + 1) - tl.load(
+            query_start_len_ptr + seq_idx
+        )
+    _, _, act_num_segments = segment_range(
+        seq_len,
+        query_len,
+        TILE_SIZE,
+        NUM_SEGMENTS_PER_SEQ,
+        SLIDING_WINDOW,
+        WINDOW_SPLIT,
+    )
+    single_tile: tl.constexpr = (
+        SEGMENT_BLOCK == 0 or SEGMENT_BLOCK >= NUM_SEGMENTS_PER_SEQ
+    )
+    if single_tile:
+        segm_mask = tl.arange(0, NUM_SEGMENTS_PER_SEQ) < tl.full(
+            [NUM_SEGMENTS_PER_SEQ], act_num_segments, dtype=tl.int32
+        )
+
+    # the norm needs the whole head in one program: the wrapper only launches BLOCK_D 0 or >= V_HEAD_SIZE
+    D_TILE: tl.constexpr = V_HEAD_SIZE_PADDED
+    offs_vd = tl.arange(0, V_HEAD_SIZE_PADDED)
+    if V_HEAD_SIZE_PADDED != V_HEAD_SIZE:
+        v_dim_mask = offs_vd < V_HEAD_SIZE
+    else:
+        v_dim_mask = tl.full((1,), 1, dtype=tl.int1)
+
+    if single_tile:
+        segm_offset = (
+            query_token_idx.to(tl.int64) * (num_query_heads * NUM_SEGMENTS_PER_SEQ)
+            + query_head_idx * NUM_SEGMENTS_PER_SEQ
+            + tl.arange(0, NUM_SEGMENTS_PER_SEQ)
+        )
+        segm_max = tl.load(
+            segm_max_ptr + segm_offset, mask=segm_mask, other=float("-inf")
+        )
+        overall_max = tl.max(segm_max)
+        segm_expsum = tl.load(segm_expsum_ptr + segm_offset, mask=segm_mask, other=0.0)
+        segm_expsum = segm_expsum * tl.math.exp2(segm_max - overall_max)
+        overall_expsum = tl.sum(segm_expsum)
+        segm_output_offset = (
+            query_token_idx.to(tl.int64)
+            * (num_query_heads * NUM_SEGMENTS_PER_SEQ * V_HEAD_SIZE_PADDED)
+            + query_head_idx * (NUM_SEGMENTS_PER_SEQ * V_HEAD_SIZE_PADDED)
+            + tl.arange(0, NUM_SEGMENTS_PER_SEQ)[:, None] * V_HEAD_SIZE_PADDED
+            + offs_vd[None, :]
+        )
+        segm_output = tl.load(
+            segm_output_ptr + segm_output_offset,
+            mask=segm_mask[:, None] & v_dim_mask[None, :],
+            other=0.0,
+        )
+        segm_output *= tl.math.exp2(segm_max - overall_max)[:, None]
+        acc_sum = tl.sum(segm_output, axis=0)
+    else:
+        segm_base = (
+            query_token_idx.to(tl.int64) * (num_query_heads * NUM_SEGMENTS_PER_SEQ)
+            + query_head_idx * NUM_SEGMENTS_PER_SEQ
+        )
+        segm_output_base = query_token_idx.to(tl.int64) * (
+            num_query_heads * NUM_SEGMENTS_PER_SEQ * V_HEAD_SIZE_PADDED
+        ) + query_head_idx * (NUM_SEGMENTS_PER_SEQ * V_HEAD_SIZE_PADDED)
+        offs_all = tl.arange(0, NUM_SEGMENTS_PER_SEQ)
+        all_mask = offs_all < act_num_segments
+        segm_max_all = tl.load(
+            segm_max_ptr + segm_base + offs_all, mask=all_mask, other=float("-inf")
+        )
+        overall_max = tl.max(segm_max_all)
+        segm_expsum_all = tl.load(
+            segm_expsum_ptr + segm_base + offs_all, mask=all_mask, other=0.0
+        )
+        overall_expsum = tl.sum(
+            segm_expsum_all * tl.math.exp2(segm_max_all - overall_max)
+        )
+        offs_s = tl.arange(0, SEGMENT_BLOCK)
+        acc_sum = tl.zeros([D_TILE], dtype=tl.float32)
+        for s0 in range(0, act_num_segments, SEGMENT_BLOCK):
+            segs = s0 + offs_s
+            segm_mask = segs < act_num_segments
+            weight = tl.math.exp2(
+                tl.load(
+                    segm_max_ptr + segm_base + segs,
+                    mask=segm_mask,
+                    other=float("-inf"),
+                )
+                - overall_max
+            )
+            segm_output = tl.load(
+                segm_output_ptr
+                + segm_output_base
+                + segs[:, None] * V_HEAD_SIZE_PADDED
+                + offs_vd[None, :],
+                mask=segm_mask[:, None] & v_dim_mask[None, :],
+                other=0.0,
+            )
+            acc_sum += tl.sum(segm_output * weight[:, None], axis=0)
+    acc = tl.where(overall_expsum == 0.0, 0.0, acc_sum / overall_expsum)
+
+    # epilogue: what the served norm-gate kernel computes from the stored attention output
+    x = acc.to(output_ptr.type.element_ty).to(tl.float32)
+    var = tl.sum(tl.where(v_dim_mask, x * x, 0.0), axis=0) / V_HEAD_SIZE
+    rstd = 1.0 / tl.sqrt(var + norm_eps)
+    x = x * rstd
+    group_idx = query_head_idx // HEADS_PER_GROUP
+    head_in_group = query_head_idx % HEADS_PER_GROUP
+    g = tl.load(
+        gate_ptr
+        + query_token_idx * stride_g0
+        + group_idx * stride_g1
+        + head_in_group * V_HEAD_SIZE
+        + offs_vd,
+        mask=v_dim_mask,
+        other=0.0,
+    ).to(tl.float32)
+    x = x * tl.sigmoid(g)
+
+    output_offset = (
+        query_token_idx * output_stride_0 + query_head_idx * output_stride_1 + offs_vd
+    )
+    tl.store(
+        output_ptr + output_offset,
+        x.to(output_ptr.type.element_ty),
+        mask=v_dim_mask,
+    )
