diff --git a/python/sglang/kernels/ops/speculative/dflash_verify_meta.py b/python/sglang/kernels/ops/speculative/dflash_verify_meta.py
new file mode 100644
index 0000000000..5915af6bdf
--- /dev/null
+++ b/python/sglang/kernels/ops/speculative/dflash_verify_meta.py
@@ -0,0 +1,138 @@
+"""Target-verify attention metadata of the Triton backend (the DFlash draft runner) in one launch.
+
+``TritonAttnBackend._update_target_verify_buffers`` fills qo_indptr (arange), kv_indptr (cumsum) + the full kv_indices
+gather, the sliding-window lengths / indptr / start offsets + the window gather, and mask_indptr (cumsum) in ~15
+launches. This kernel writes the same integers: grid (bs, token blocks), every program recomputes the prefix sums it
+needs from the (few) sequence lengths, and the gathers are ``create_flashinfer_kv_indices_triton``'s loads.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _gather_rows(
+    ids_ptr, row, row_stride, start, n, out_ptr, out_off, blk, num_blk, mapping_ptr,
+    ENTRY_PAGE_SIZE: tl.constexpr, HAS_MAPPING: tl.constexpr,
+):
+    BLOCK: tl.constexpr = 512
+    start = (start + n * 0).to(tl.int32)  # start may be a literal 0
+    n = n.to(tl.int32)
+    num_loop = tl.cdiv(n, BLOCK)
+    for i in range(blk, num_loop, num_blk):
+        offset = tl.arange(0, BLOCK).to(tl.int64) + i * BLOCK
+        mask = offset < n
+        if ENTRY_PAGE_SIZE == 1:
+            data = tl.load(ids_ptr + row * row_stride + start + offset, mask=mask)
+        else:
+            pos = start + offset
+            entry = tl.load(ids_ptr + row * row_stride + pos // ENTRY_PAGE_SIZE, mask=mask)
+            data = entry.to(tl.int64) * ENTRY_PAGE_SIZE + pos % ENTRY_PAGE_SIZE
+        if HAS_MAPPING:
+            data = tl.load(mapping_ptr + data, mask=mask & (data >= 0), other=-1)
+        tl.store(out_ptr + out_off + offset, data, mask=mask)
+
+
+@triton.jit
+def _dflash_verify_meta_kernel(
+    seq_lens_ptr,
+    bs,
+    tokens_per_req,
+    window,
+    full_ids_ptr,
+    full_rows_ptr,
+    full_row_stride,
+    win_ids_ptr,
+    win_rows_ptr,
+    win_row_stride,
+    win_mapping_ptr,
+    qo_indptr_ptr,
+    kv_indptr_ptr,
+    kv_indices_ptr,
+    win_indptr_ptr,
+    win_indices_ptr,
+    win_offsets_ptr,
+    mask_indptr_ptr,
+    BS_PAD: tl.constexpr,
+    FULL_PAGE: tl.constexpr,
+    WIN_PAGE: tl.constexpr,
+    HAS_MAPPING: tl.constexpr,
+    GATHER_FULL: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    blk = tl.program_id(1)
+    num_blk = tl.num_programs(1)
+    j = tl.arange(0, BS_PAD)
+    s_all = tl.load(seq_lens_ptr + j, mask=j < bs, other=0).to(tl.int64)
+    w_all = tl.minimum(s_all, window)
+    before = j < pid
+    upto = j <= pid
+    full_off = tl.sum(tl.where(before, s_all, 0), axis=0)
+    win_off = tl.sum(tl.where(before, w_all, 0), axis=0)
+    s = tl.load(seq_lens_ptr + pid).to(tl.int64)
+    wl = tl.minimum(s, window)
+    if blk == 0:
+        T = tokens_per_req.to(tl.int64)
+        tl.store(qo_indptr_ptr + pid, pid * T)
+        if pid == bs - 1:
+            tl.store(qo_indptr_ptr + bs, bs * T)
+        tl.store(kv_indptr_ptr + pid + 1, full_off + s)
+        tl.store(win_indptr_ptr + pid + 1, win_off + wl)
+        tl.store(win_offsets_ptr + pid, s - wl)
+        tl.store(mask_indptr_ptr + pid + 1, tl.sum(tl.where(upto, T * (s_all + T), 0), axis=0))
+    if GATHER_FULL:
+        row = tl.load(full_rows_ptr + pid).to(tl.int64)
+        _gather_rows(full_ids_ptr, row, full_row_stride, 0, s, kv_indices_ptr, full_off, blk, num_blk,
+                     win_mapping_ptr, FULL_PAGE, False)
+    row = tl.load(win_rows_ptr + pid).to(tl.int64)
+    _gather_rows(win_ids_ptr, row, win_row_stride, s - wl, wl, win_indices_ptr, win_off, blk, num_blk,
+                 win_mapping_ptr, WIN_PAGE, HAS_MAPPING)
+
+
+def dflash_verify_meta_(
+    *,
+    seq_lens: torch.Tensor,
+    tokens_per_req: int,
+    window: int,
+    full_src,
+    win_src,
+    win_mapping,
+    qo_indptr: torch.Tensor,
+    kv_indptr: torch.Tensor,
+    kv_indices: torch.Tensor,
+    win_indptr: torch.Tensor,
+    win_indices: torch.Tensor,
+    win_offsets: torch.Tensor,
+    mask_indptr: torch.Tensor,
+    gather_full: bool = True,
+    token_blocks: int = 16,
+) -> None:
+    """``full_src`` / ``win_src``: ``KVIndexTable``-like (ids, row_ids, row_stride, entry_page_size)."""
+    bs = int(seq_lens.numel())
+    _dflash_verify_meta_kernel[(bs, token_blocks)](
+        seq_lens,
+        bs,
+        tokens_per_req,
+        window,
+        full_src.ids,
+        full_src.row_ids,
+        full_src.row_stride,
+        win_src.ids,
+        win_src.row_ids,
+        win_src.row_stride,
+        win_mapping if win_mapping is not None else seq_lens,
+        qo_indptr,
+        kv_indptr,
+        kv_indices,
+        win_indptr,
+        win_indices,
+        win_offsets,
+        mask_indptr,
+        BS_PAD=max(16, triton.next_power_of_2(bs)),
+        FULL_PAGE=full_src.entry_page_size,
+        WIN_PAGE=win_src.entry_page_size,
+        HAS_MAPPING=win_mapping is not None,
+        GATHER_FULL=gather_full,
+        num_warps=4,
+    )
