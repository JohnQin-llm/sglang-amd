+        and os.environ.get("AITER_CUSTOM_AR_DISABLE_LL", "") in ("", "0")
+        and getattr(ca_comm, "world_size", 0) in (2, 4)
+        and 0 < nbytes <= _AITER_LL_MAX_BYTES
+        and nbytes % 16 == 0
+        and input_.is_contiguous()
+    )
 
 TensorMetadata = namedtuple("TensorMetadata", ["device", "dtype", "size"])
 
@@ -1040,7 +1057,15 @@ class GroupCoordinator:
         assert any([qr_comm, ca_comm, pymscclpp_comm, torch_symm_mem_comm, pynccl_comm])
         if outplace_all_reduce_method == "ca":
             assert not ca_comm.disabled
-            out = ca_comm.custom_all_reduce(input_)
+            if _AR_LL_DIRECT and _aiter_ll_route(ca_comm, input_):
+                # gfx1250 LL lane: the kernel reads the input on this rank only and pushes it
+                # to the peers' scratch, so the copy into the registered pool is not needed.
+                if ca_comm._IS_CAPTURING and not torch.cuda.is_current_stream_capturing():
+                    out = torch.zeros_like(input_)
+                else:
+                    out = ca_comm.all_reduce(input_, registered_input=True)
+            else:
+                out = ca_comm.custom_all_reduce(input_)
         elif outplace_all_reduce_method == "qr":
             assert not qr_comm.disabled
             out = qr_comm.quick_all_reduce(input_)
