+        """The one-launch FP8 prefix-valid commit over all draft layers, or None where
+        ``set_kv_buffer_prefix_valid``'s eager cast + tiled store is not what it reproduces."""
+        commit = getattr(self, "_ctx_kv_commit_fp8_op", False)
